{
  "name": "bncc-mcp-worker",
  "version": "0.2.2",
  "private": true,
  "description": "Servidor MCP remoto da BNCC (mcp.bncc.dev): as tools do @bncc/mcp via streamable HTTP em Cloudflare Workers, sem instalação e sem API key.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "verificar-bundle": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@bncc/dados": "workspace:*",
    "@bncc/mcp": "workspace:*",
    "@hono/mcp": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
