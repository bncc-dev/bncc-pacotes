{
  "name": "@bncc/mcp",
  "version": "0.2.1",
  "description": "Servidor MCP da BNCC: as 1.721 aprendizagens da Base Nacional Comum Curricular e do complemento de Computação, verificadas e com fonte oficial, como tools para agentes de IA. Casca sobre @bncc/dados.",
  "keywords": [
    "bncc",
    "mcp",
    "modelcontextprotocol",
    "educacao",
    "claude",
    "agentes"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bncc-dev/bncc-pacotes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bncc-dev/bncc-pacotes.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "bncc-mcp": "dist/servidor.js"
  },
  "exports": {
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@bncc/dados": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
