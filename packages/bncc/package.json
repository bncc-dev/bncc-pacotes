{
  "name": "@bncc/dados",
  "version": "0.3.1",
  "description": "A BNCC (Base Nacional Comum Curricular) como dados estruturados e verificados, com API de consulta tipada. Inclui o complemento de Computação (1.721 aprendizagens). Em desenvolvimento: a v1.0 sai junto da release dados-v1.0.0 do bncc-dados.",
  "keywords": [
    "bncc",
    "educacao",
    "base nacional comum curricular",
    "mec",
    "habilidades",
    "curriculo",
    "brasil"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bncc-dev/bncc-pacotes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bncc-dev/bncc-pacotes.git",
    "directory": "packages/bncc"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nucleo": {
      "types": "./dist/nucleo.d.ts",
      "import": "./dist/nucleo.js",
      "require": "./dist/nucleo.cjs"
    },
    "./dados/*.json": "./dados/*.json"
  },
  "files": [
    "dist",
    "dados",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/nucleo.ts --format esm,cjs --dts --clean --shims",
    "test": "vitest run && node test/cjs-smoke.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
