---
import Base from '../../layouts/Base.astro';
import { estatisticas, versao } from '../../lib/dados';

const s = estatisticas();
const v = versao();
const exemploCurl = `curl https://api.bncc.dev/v1/aprendizagens/EF67LP08`;
const exemploBusca = `curl "https://api.bncc.dev/v1/busca?q=fake%20news&etapa=EM"`;
const exemploResposta = `{
  "codigo": "EF67LP08",
  "etapa": "EF",
  "componente": { "id": "ef-comp-lp", "nome": "Língua Portuguesa" },
  "anos": [6, 7],
  "texto": "Identificar os efeitos de sentido…",
  "fonte": { "localizador_pdf": "…página PDF 167" }
}`;
---
<Base titulo="API da BNCC · REST aberta, sem key · bncc.dev"
      descricao={`A BNCC como serviço REST: as ${s.total.toLocaleString('pt-BR')} aprendizagens por HTTP, sem cadastro e sem API key. Beta com limite por IP; OpenAPI 3.1.`}>
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li>API</li>
  </nav>
  <h1 class="titulo-secao">API da BNCC <span class="chip accent">beta</span></h1>
  <p class="h2-hint">A mesma base deste site como serviço REST em <code>api.bncc.dev</code>: aberta, gratuita, sem cadastro e sem API key. Respostas em JSON com nomes resolvidos, cache agressivo (o dado é imutável por versão) e erros que explicam. Dados {v.data_version}, verificados contra o documento homologado do MEC.</p>

  <section aria-labelledby="h-comecar">
    <h2 id="h-comecar">Comece em uma linha</h2>
    <div class="codeblock">
      <button class="btn-copiar" type="button" onclick="copiarBloco(this)">copiar</button>
      <pre set:text={exemploCurl} />
    </div>
    <div class="codeblock">
      <button class="btn-copiar" type="button" onclick="copiarBloco(this)">copiar</button>
      <pre set:text={exemploBusca} />
    </div>
    <p class="h2-hint">Resposta (resumida):</p>
    <div class="codeblock">
      <pre set:text={exemploResposta} />
    </div>
  </section>

  <section aria-labelledby="h-rotas">
    <h2 id="h-rotas">Rotas</h2>
    <ul class="lista">
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/aprendizagens/&#123;codigo&#125;</span><span class="resumo">registro completo de uma habilidade ou objetivo, com nomes resolvidos e fonte oficial</span></a></li>
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/habilidades</span><span class="resumo">EF e EM com filtros (etapa, componente, ano, prática, área, competência) e paginação</span></a></li>
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/objetivos</span><span class="resumo">Educação Infantil por campo de experiências e grupo etário</span></a></li>
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/busca</span><span class="resumo">busca textual normalizada nos enunciados (a mesma da página Buscar)</span></a></li>
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/decodificar/&#123;codigo&#125;</span><span class="resumo">anatomia do código: etapa, anos, componente, sequência</span></a></li>
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/estrutura</span><span class="resumo">etapas, áreas, componentes, campos e competências (e cada coleção individual)</span></a></li>
      <li><a href="https://api.bncc.dev/v1/openapi.json" rel="noopener"><span class="cod">GET /v1/estatisticas</span><span class="resumo">contagens do dataset e versão dos dados</span></a></li>
    </ul>
    <p class="h2-hint">Especificação completa: <a href="https://api.bncc.dev/v1/openapi.json" rel="noopener">OpenAPI 3.1</a> · código do serviço: <a href="https://github.com/bncc-dev/bncc-api" rel="noopener">github.com/bncc-dev/bncc-api</a></p>
  </section>

  <section aria-labelledby="h-limites">
    <h2 id="h-limites">Limites e alternativas</h2>
    <p class="h2-hint">O beta tem limite de requisições por IP, sem key e sem cobrança. Para volume alto ou uso offline, os mesmos dados rodam localmente sem nenhum limite: pacote <a href="https://www.npmjs.com/package/@bncc/dados" rel="noopener">@bncc/dados</a> (npm), pacote <a href="https://pypi.org/project/bncc/" rel="noopener">bncc</a> (PyPI), <a href="https://github.com/bncc-dev/bncc-pacotes" rel="noopener">servidor MCP</a> para agentes de IA, ou o <a href="https://github.com/bncc-dev/bncc-dados" rel="noopener">dataset bruto</a> (JSON, SQLite, CSV). O acesso ao dado é aberto e assim permanece: <a href="https://github.com/bncc-dev/bncc-dados/blob/main/docs/divisao-aberto-comercial.md" rel="noopener">a regra de ouro está por escrito</a>.</p>
  </section>
</Base>
