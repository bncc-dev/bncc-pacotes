---
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, rotaDe } from '../../lib/dados';
import {
  COMPUTACAO, aprendizagensCO, competenciasEmCO, competenciasGeraisCO, estatisticasCO,
} from '../../lib/computacao';

const s = estatisticasCO();
const todas = aprendizagensCO();
const ei = todas.filter((a) => a.etapa === 'EI');
const em = todas.filter((a) => a.etapa === 'EM');
const efPorRecorte: Array<{ rotulo: string; ancora: string; habs: typeof todas }> = [
  ...[1, 2, 3, 4, 5, 6, 7, 8, 9].map((ano) => ({
    rotulo: `${ano}º ano`,
    ancora: `ef-${ano}-ano`,
    habs: todas.filter((a) => a.etapa === 'EF' && a.anos!.length === 1 && a.anos![0] === ano),
  })),
  { rotulo: '1º ao 5º ano (bloco EF15)', ancora: 'ef-15', habs: todas.filter((a) => a.codigo.startsWith('EF15')) },
  { rotulo: '6º ao 9º ano (bloco EF69)', ancora: 'ef-69', habs: todas.filter((a) => a.codigo.startsWith('EF69')) },
];
const emPorCompetencia = competenciasEmCO().map((c) => ({
  competencia: c,
  habs: em.filter((a) => a.competencia?.id === c.id),
}));
const cortar = (t: string, n = 140) => (t.length > n ? t.slice(0, n - 3) + '…' : t);
const descricao = `As ${s.total} aprendizagens de Computação do complemento à BNCC (${COMPUTACAO.parecer}): ${s.ei} objetivos na Educação Infantil, ${s.ef} habilidades no Fundamental e ${s.em} no Médio, por eixo e objeto de conhecimento, com texto oficial verificado.`;
---
<Base titulo={`Computação · complemento à BNCC · ${s.total} aprendizagens · bncc.dev`}
      descricao={descricao}
      jsonLd={breadcrumbJsonLd([{ nome: 'Computação' }])}>
  <nav class="trilha"><li><a href="/">bncc.dev</a></li><li>Computação</li></nav>
  <h1 class="titulo-secao">Computação
    <span class="chip" style={`background:${COMPUTACAO.cor};color:#fff;border-color:${COMPUTACAO.cor};vertical-align:middle;margin-left:8px`}>{COMPUTACAO.badge}</span>
  </h1>
  <p class="subtitulo">
    A Computação na Educação Básica é um <strong>complemento à BNCC</strong>, aprovado pelo {COMPUTACAO.parecer}
    e instituído pela {COMPUTACAO.resolucao}. Não é uma quarta etapa nem um componente da BNCC de 2018:
    são {s.total} aprendizagens próprias (códigos com <span class="mono">CO</span>) que atravessam as três etapas,
    organizadas em três eixos. Cada texto desta seção foi conferido caractere a caractere contra o
    <a href={COMPUTACAO.urlAnexo} rel="noopener">anexo oficial ↗</a>.
  </p>

  <section class="bloco" aria-labelledby="h-eixos">
    <h2 id="h-eixos">Os três eixos</h2>
    <ul class="lista">
      {s.porEixo.map((e) => (
        <li><a href={`#${e.id.replace('co-eixo-', '')}`}>
          <span class="cod" style={`color:${COMPUTACAO.cor}`}>■</span>{e.nome}
          <span class="resumo"> · {e.total} aprendizagens no Fundamental e na Infantil</span>
        </a></li>
      ))}
    </ul>
    <p class="h2-hint">No Ensino Médio, o complemento se organiza por competências específicas (abaixo), não por eixo.</p>
  </section>

  <section class="bloco" aria-labelledby="h-ei" id="infantil">
    <h2 id="h-ei">Educação Infantil · {s.ei} objetivos (pré-escola)</h2>
    <p class="h2-hint">O complemento define objetivos apenas para crianças pequenas (4 anos a 5 anos e 11 meses); códigos EI03CO.</p>
    <ul class="lista">
      {ei.map((a) => (
        <li><a href={rotaDe(a.codigo)}>
          <span class="cod">{a.codigo}</span>
          <span class="resumo">{cortar(a.texto)}</span>
        </a></li>
      ))}
    </ul>
  </section>

  <section class="bloco" aria-labelledby="h-ef" id="fundamental">
    <h2 id="h-ef">Ensino Fundamental · {s.ef} habilidades</h2>
    <p class="h2-hint">Por ano (1º a 9º) e em dois blocos por segmento (EF15 e EF69), organizadas em eixo › objeto de conhecimento.</p>
    {efPorRecorte.map((grupo) => grupo.habs.length > 0 && (
      <details class="grupo-listagem" id={grupo.ancora}>
        <summary><strong>{grupo.rotulo}</strong> · {grupo.habs.length} habilidades</summary>
        <ul class="lista">
          {grupo.habs.map((a) => (
            <li><a href={rotaDe(a.codigo)}>
              <span class="cod">{a.codigo}</span>
              <span class="resumo">{a.eixo!.nome} · {cortar(a.texto, 110)}</span>
            </a></li>
          ))}
        </ul>
      </details>
    ))}
  </section>

  <section class="bloco" aria-labelledby="h-em" id="medio">
    <h2 id="h-em">Ensino Médio · {s.em} habilidades</h2>
    <p class="h2-hint">Vinculadas às 7 competências específicas de Computação do EM (sem seriação).</p>
    {emPorCompetencia.map(({ competencia, habs }) => (
      <details class="grupo-listagem">
        <summary><strong>Competência {competencia.numero}</strong> · {cortar(competencia.texto, 120)} · {habs.length} habilidades</summary>
        <ul class="lista">
          {habs.map((a) => (
            <li><a href={rotaDe(a.codigo)}>
              <span class="cod">{a.codigo}</span>
              <span class="resumo">{cortar(a.texto, 130)}</span>
            </a></li>
          ))}
        </ul>
      </details>
    ))}
  </section>

  <section class="bloco" aria-labelledby="h-cg">
    <h2 id="h-cg">As {competenciasGeraisCO().length} competências gerais do complemento</h2>
    <ol class="lista-competencias">
      {competenciasGeraisCO().map((c) => (
        <li><p class="texto-oficial">{c.texto}</p></li>
      ))}
    </ol>
  </section>

  <section class="bloco" aria-labelledby="h-fonte">
    <h2 id="h-fonte">Proveniência</h2>
    <p>Extraído do <a href={COMPUTACAO.urlAnexo} rel="noopener">anexo oficial ao {COMPUTACAO.parecer} ↗</a>,
    instituído pela {COMPUTACAO.resolucao} (homologação publicada no D.O.U. de 3/10/2022).
    Processo reprodutível e validado em CI; decisões de interpretação nas entradas 9 e 10 do
    <a href="https://github.com/bncc-dev/bncc-dados/blob/main/DECISOES.md" rel="noopener">DECISOES.md</a>.</p>
  </section>
</Base>

<style>
  .grupo-listagem { margin: 10px 0; }
  .grupo-listagem summary { cursor: pointer; padding: 8px 0; }
  .lista-competencias { padding-left: 22px; display: grid; gap: 10px; }

</style>

<script is:inline>
  // Quem chega por âncora de grupo (ex.: /computacao/#ef-2-ano, vindo do bloco
  // "este ano também tem") encontra o recorte já aberto, no lugar certo.
  const abrirGrupoDoHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const alvo = document.getElementById(id);
    if (!alvo) return;
    const det = alvo.closest('details');
    if (det && !det.open) det.open = true;
    // reancora o scroll depois de abrir (a altura da página muda)
    requestAnimationFrame(() => alvo.scrollIntoView({ block: 'start' }));
  };
  abrirGrupoDoHash();
  addEventListener('hashchange', abrirGrupoDoHash);
</script>
