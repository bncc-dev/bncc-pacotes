---
import Base from '../../layouts/Base.astro';
import { SITE, breadcrumbJsonLd, competenciasEspecificas, habilidadesDaCompetencia, rotaDe, versao } from '../../lib/dados';
import type { CompetenciaResolvida } from '../../lib/dados';

export function getStaticPaths() {
  return competenciasEspecificas().map((ce) => ({ params: { id: ce.id }, props: { ce } }));
}

const { ce } = Astro.props as { ce: CompetenciaResolvida };
const vinculadas = habilidadesDaCompetencia(ce.id);
const resumo = ce.texto.length > 110 ? ce.texto.slice(0, 107) + '…' : ce.texto;
const jsonLdCe = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: `Competência específica ${ce.numero} de ${ce.contexto.nome} · BNCC`,
    identifier: ce.id,
    description: ce.texto,
    url: `${SITE}/competencia/${ce.id}/`,
    inLanguage: 'pt-BR',
    educationalLevel: ce.etapa === 'EM' ? 'Ensino Médio (1ª a 3ª série)' : 'Ensino Fundamental',
    version: versao().data_version,
    educationalAlignment: {
      '@type': 'AlignmentObject',
      alignmentType: 'educationalSubject',
      educationalFramework: 'Base Nacional Comum Curricular (BNCC)',
      targetName: `Competência específica ${ce.numero} · ${ce.contexto.nome}`,
      targetDescription: ce.texto,
    },
    isPartOf: { '@id': `${SITE}/#dataset` },
    isBasedOn: 'https://github.com/bncc-dev/bncc-dados',
    license: 'https://creativecommons.org/licenses/by/4.0/deed.pt-br',
  },
  breadcrumbJsonLd([
    { nome: 'Competências', url: '/competencias/' },
    { nome: `CE ${ce.numero} · ${ce.contexto.nome}` },
  ]),
];
---
<Base titulo={`Competência específica ${ce.numero} de ${ce.contexto.nome} · BNCC · bncc.dev`}
      descricao={`CE ${ce.numero} (${ce.contexto.nome}, ${ce.etapa === 'EM' ? 'Ensino Médio' : 'Ensino Fundamental'}): ${resumo}`}
      etapa={ce.etapa} ogType="article" jsonLd={jsonLdCe}>
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li><a href="/competencias/">Competências</a></li>
    <li>CE {ce.numero} · {ce.contexto.nome}</li>
  </nav>

  <h1 class="titulo-secao">Competência específica {ce.numero}</h1>
  <p class="h2-hint">{ce.contexto.rotulo}: {ce.contexto.href ? <a href={ce.contexto.href}>{ce.contexto.nome}</a> : ce.contexto.nome}</p>

  <blockquote class="texto-oficial">
    <p>{ce.texto}</p>
  </blockquote>

  {ce.etapa === 'EM' ? (
    <section aria-labelledby="h-vinculadas">
      <h2 id="h-vinculadas">Habilidades vinculadas</h2>
      <p class="h2-hint">Vínculo oficial da BNCC: no Ensino Médio, o código de cada habilidade carrega a competência (o dígito após a área). São {vinculadas.length} habilidades desta competência.</p>
      <ul class="lista">
        {vinculadas.map((h) => (
          <li><a href={rotaDe(h.codigo)}>
            <span class="cod">{h.codigo}</span>
            <span class="resumo">{h.texto.length > 140 ? h.texto.slice(0, 137) + '…' : h.texto}</span>
          </a></li>
        ))}
      </ul>
    </section>
  ) : (
    <section aria-labelledby="h-sem-vinculo">
      <h2 id="h-sem-vinculo">Habilidades relacionadas</h2>
      <p class="h2-hint">No Ensino Fundamental, a BNCC não vincula habilidades a competências específicas (esse vínculo formal só existe no Ensino Médio). Não inventamos a relação: explore as habilidades {ce.contexto.href ? <a href={ce.contexto.href}>de {ce.contexto.nome}</a> : <a href="/fundamental/">do Ensino Fundamental</a>} e consulte o texto da competência acima como lente de leitura.</p>
    </section>
  )}
</Base>
