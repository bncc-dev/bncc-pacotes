---
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd } from '../../lib/dados';
import { BENCHMARK, NOME_TAREFA, dataCurta, nota, pct, usd } from '../../lib/benchmark';

const b = BENCHMARK;
const m = b.meta;

// Valores agregados para os "Principais achados" (derivados, não editados à mão).
const primeiro = b.modelos[0];
const ultimo = b.modelos[b.modelos.length - 1];
const media = (f: (x: (typeof b.modelos)[number]) => number): number =>
  b.modelos.reduce((s, x) => s + f(x), 0) / b.modelos.length;
const mediaFiel = media((x) => x.a_fiel);
const mediaAluc = media((x) => x.a_aluc);
const mediaNegaReais = 1 - media((x) => x.b_reais);
const recEtapa = Object.fromEntries(b.recortes.por_etapa.map((r) => [r.rotulo, r.taxa]));
const recModulo = Object.fromEntries(b.recortes.por_modulo.map((r) => [r.rotulo, r.taxa]));

// Amostras cruas reais por modelo (até 10 cada), para o drawer de JSON bruto.
// Vem prontas do exportador do benchmark; o arquivo completo (900 respostas por
// modelo) fica gated na release dados-v1.0.0.
const amostrasPorModelo: Record<string, unknown[]> = {};
for (const [modelo, lista] of Object.entries(b.amostras_drawer)) {
  amostrasPorModelo[modelo] = lista.map((a) => ({
    item_id: a.item_id,
    parafrase: a.parafrase,
    tarefa: a.tarefa,
    pergunta: a.pergunta,
    resposta: a.resposta,
    veredito: a.veredito,
    ok: a.ok,
  }));
}

const LOGOS: Record<string, string> = {
  OpenAI: 'openai',
  Anthropic: 'anthropic',
  Google: 'google',
  xAI: 'xai',
  DeepSeek: 'deepseek',
  Alibaba: 'qwen',
  Moonshot: 'moonshot',
  'Maritaca AI': 'maritaca',
};
---
<Base titulo="Leaderboard · benchmark de alucinação da BNCC · bncc.dev"
      descricao={`A tabela completa da rodada ${m.versao} do benchmark de alucinação: ${m.total_modelos} modelos, nota por dimensão, invenção pura separada de confusão com currículos derivados, e amostras reais das respostas julgadas.`}
      jsonLd={breadcrumbJsonLd([{ nome: 'benchmark', url: '/benchmark/' }, { nome: 'leaderboard', url: '/benchmark/leaderboard/' }])}>

  <ol class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li><a href="/benchmark/">benchmark</a></li>
    <li>leaderboard</li>
  </ol>

  <div class="badges-topo">
    <span class="pub-label selo-vermelho">Benchmark de alucinação</span><span class="versao-label">{m.versao}</span>
  </div>

  <div class="cabecalho">
    <div class="cabecalho-texto">
      <h1 class="abre">Leaderboard do benchmark</h1>
      <p class="abre-sub">Modelos de linguagem tendem a produzir códigos e textos da BNCC que parecem plausíveis, mas não existem. Medimos essa alucinação em condição fechada, sem acesso a fonte externa (como pesquisa web ou datasets), ao longo de cinco dimensões de competência curricular. A metodologia separa a invenção pura (códigos ausentes de qualquer fonte) da confusão com currículos derivados, com temperatura fixa e versões pinadas para reprodutibilidade. Esta página traz a tabela completa por modelo, a nota por dimensão e as respostas cruas. Leitura guiada no <a href="/benchmark/">resumo dos resultados</a>.</p>
    </div>

    <div class="metadados" aria-label="Metadados da rodada">
      <div class="md-item"><span class="md-k">Condição</span><span class="md-v">sem ferramenta</span></div>
      <div class="md-item"><span class="md-k">Banco de itens</span><span class="md-v">{m.itens_versao} · {m.total_itens} itens</span></div>
      <div class="md-item"><span class="md-k">Gabarito (dataset)</span><span class="md-v">{m.dataset_versao}</span></div>
      <div class="md-item"><span class="md-k">Avaliador</span><span class="md-v">v{m.avaliador_versao} · rubrica-v1</span></div>
      <div class="md-item"><span class="md-k">Medido em</span><span class="md-v">{dataCurta(m.medido_em)}</span></div>
    </div>
  </div>

  <section class="faixa faixa-tabela" aria-label="Tabela do leaderboard por modelo">
    <div class="rolagem">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Modelo</th>
            <th class="num">Nota <span class="th-info" tabindex="0" data-tip="Nota composta 0-100: média das cinco dimensões medidas. Critério de ordenação da tabela.">i</span></th>
            <th class="num">Confirma <span class="th-info" tabindex="0" data-tip="Códigos reais confirmados: perguntado se um código verdadeiro existe, disse que sim.">i</span></th>
            <th class="num">Invenção pura <span class="th-info" tabindex="0" data-tip="Códigos falsos aceitos como reais, contando só os que não existem em NENHUMA fonte (protocolo anti-vexame). Quanto menor, melhor.">i</span></th>
            <th class="num">Confusão-derivado <span class="th-info" tabindex="0" data-tip="Códigos que não estão na BNCC mas existem em currículos derivados dela, aceitos como reais. Erro mais desculpável, medido à parte. Quanto menor, melhor.">i</span></th>
            <th class="num">Transcreve <span class="th-info" tabindex="0" data-tip="Transcrição: pedido o texto oficial de um código real, respondeu com o texto certo (exato ou paráfrase fiel).">i</span></th>
            <th class="num">Localiza <span class="th-info" tabindex="0" data-tip="Lookup inverso: dado o texto oficial de uma habilidade, encontrou o código correspondente.">i</span></th>
            <th class="num">Cita <span class="th-info" tabindex="0" data-tip="Geração aberta: dos códigos que o modelo citou espontaneamente em listas, quantos vieram com o texto oficial certo.">i</span></th>
            <th class="num">Custo US$ <span class="th-info alinhar-direita" tabindex="0" data-tip={`Custo total das ${(m.total_itens * 3).toLocaleString('pt-BR')} respostas deste modelo na rodada.`}>i</span></th>
          </tr>
        </thead>
        <tbody>
          {b.modelos.map((mod) => (
            <>
              <tr class="linha-modelo" data-alvo={`det-${mod.posicao}`}>
                <td class="rank"><button class="btn-expandir" aria-expanded="false" aria-controls={`det-${mod.posicao}`}>{mod.posicao} <span class="seta">▸</span></button></td>
                <td class="modelo">{mod.nome}<small><svg class="logo-provedor" aria-hidden="true"><use href={`#logo-${LOGOS[mod.empresa]}`}></use></svg>{mod.empresa} · {mod.tier}</small></td>
                <td class="num media">{nota(mod.nota)}</td>
                <td class="num nota-cel">{pct(mod.b_reais)}</td>
                <td class:list={['num', 'nota-cel', { 'flag-cel': mod.invencao_pura >= 0.3 }]}>{pct(mod.invencao_pura)}</td>
                <td class="num nota-cel">{pct(mod.confusao_derivado)}</td>
                <td class="num nota-cel">{pct(mod.a_fiel)}</td>
                <td class="num nota-cel">{pct(mod.d_ok)}</td>
                <td class="num nota-cel">{pct(mod.c_texto_ok)}</td>
                <td class="num">{usd(mod.custo_usd)}</td>
              </tr>
              <tr class="linha-detalhe" id={`det-${mod.posicao}`}>
                <td colspan="10"><div class="detalhe-viewport"><div class="detalhe-inner"><div class="detalhe">
                  <div class="detalhe-grid">
                    <aside class="ficha" aria-label={`Perfil quantitativo de ${mod.nome}`}>
                      <p class="ficha-titulo">Perfil deste modelo</p>

                      <div class="ficha-bloco">
                        <div class="ficha-rot">
                          <span>Desempenho por tarefa</span>
                          <label class="visualmente-oculto" for={`sel-tarefa-${mod.posicao}`}>Escolha a tarefa</label>
                          <select class="ficha-sel" id={`sel-tarefa-${mod.posicao}`}>
                            <option value="A">A · transcrição</option>
                            <option value="C">C · geração aberta</option>
                            <option value="D">D · lookup inverso</option>
                          </select>
                        </div>

                        <div class="tarefa-vis" data-tarefa="A">
                          <div class="barra-a" role="img" aria-label={`fiel ${pct(mod.a_fiel)}, alucinou ${pct(mod.a_aluc)}, absteve ${pct(mod.a_abstencao)}`}>
                            <span class="seg fiel" style={`width:${mod.a_fiel * 100}%`}></span>
                            <span class="seg aluc" style={`width:${mod.a_aluc * 100}%`}></span>
                            <span class="seg abst" style={`width:${mod.a_abstencao * 100}%`}></span>
                          </div>
                          <div class="ficha-legenda">
                            <span><i class="pt fiel"></i>transcreveu fiel <b>{pct(mod.a_fiel)}</b></span>
                            <span><i class="pt aluc"></i>alucinou o texto <b>{pct(mod.a_aluc)}</b></span>
                            <span><i class="pt abst"></i>absteve-se <b>{pct(mod.a_abstencao)}</b></span>
                          </div>
                        </div>

                        <div class="tarefa-vis oculto" data-tarefa="C">
                          <div class="barra-a" role="img" aria-label={`texto certo ${pct(mod.c_texto_ok)}, texto errado ${pct(Math.max(0, 1 - mod.c_texto_ok - mod.c_inventados))}, inventou ${pct(mod.c_inventados)}`}>
                            <span class="seg fiel" style={`width:${mod.c_texto_ok * 100}%`}></span>
                            <span class="seg abst" style={`width:${Math.max(0, 1 - mod.c_texto_ok - mod.c_inventados) * 100}%`}></span>
                            <span class="seg aluc" style={`width:${mod.c_inventados * 100}%`}></span>
                          </div>
                          <div class="ficha-legenda">
                            <span><i class="pt fiel"></i>texto certo <b>{pct(mod.c_texto_ok)}</b></span>
                            <span><i class="pt abst"></i>existe, texto errado <b>{pct(Math.max(0, 1 - mod.c_texto_ok - mod.c_inventados))}</b></span>
                            <span><i class="pt aluc"></i>inventou o código <b>{pct(mod.c_inventados)}</b></span>
                          </div>
                          <p class="tarefa-nota">sobre {mod.c_citados.toLocaleString('pt-BR')} códigos citados espontaneamente</p>
                        </div>

                        <div class="tarefa-vis oculto" data-tarefa="D">
                          <div class="barra-a" role="img" aria-label={`achou o código ${pct(mod.d_ok)}, errou ${pct(1 - mod.d_ok)}`}>
                            <span class="seg fiel" style={`width:${mod.d_ok * 100}%`}></span>
                            <span class="seg aluc" style={`width:${(1 - mod.d_ok) * 100}%`}></span>
                          </div>
                          <div class="ficha-legenda">
                            <span><i class="pt fiel"></i>achou o código <b>{pct(mod.d_ok)}</b></span>
                            <span><i class="pt aluc"></i>errou <b>{pct(1 - mod.d_ok)}</b></span>
                          </div>
                          <p class="tarefa-nota">dado o texto oficial, encontrar o código correspondente</p>
                        </div>
                      </div>

                      <div class="ficha-bloco">
                        <div class="ficha-rot">Códigos falsos aceitos como reais</div>
                        <div class="mini">
                          <span class="mini-k">invenção pura</span>
                          <span class="mini-track"><b class="err" style={`width:${Math.max(mod.invencao_pura * 100, 1.5)}%`}></b></span>
                          <span class="mini-v">{pct(mod.invencao_pura)}</span>
                        </div>
                        <div class="mini">
                          <span class="mini-k">confusão-derivado</span>
                          <span class="mini-track"><b class="warn" style={`width:${Math.max(mod.confusao_derivado * 100, 1.5)}%`}></b></span>
                          <span class="mini-v">{pct(mod.confusao_derivado)}</span>
                        </div>
                      </div>

                      <div class="ficha-nums">
                        <div><b>{mod.c_citados.toLocaleString('pt-BR')}</b><span>códigos citados (C)</span></div>
                        <div><b>US$ {(mod.custo_usd / (m.total_itens * 3)).toFixed(3).replace('.', ',')}</b><span>por resposta</span></div>
                      </div>
                    </aside>

                    <div class="detalhe-exemplos">
                      {mod.exemplos.map((ex) => (
                        <div class:list={['detalhe-exemplo', ex.rotulo]}>
                          <p class="detalhe-rotulo">{ex.rotulo === 'invencao' ? 'Exemplo de invenção' : ex.rotulo === 'confusao' ? 'Exemplo de confusão com currículo derivado' : 'Exemplo de abstenção'}</p>
                          <p class="detalhe-pergunta">"{ex.pergunta}"</p>
                          <p>"{ex.resposta}"</p>
                          <p class="detalhe-explica">{ex.explicacao}</p>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div class="detalhe-rodape">
                    <button type="button" class="ver-bruto" data-modelo={mod.id} data-nome={mod.nome}>ver JSON bruto ({(amostrasPorModelo[mod.id] || []).length} amostras)</button>
                    {mod.cortados > 0 && <span>{mod.cortados} respostas cortadas por limite técnico, fora das taxas</span>}
                    <span>arquivo bruto completo ({(m.total_itens * 3).toLocaleString('pt-BR')} respostas): publicação junto com o dataset 1.0</span>
                  </div>
                </div></div></div></td>
              </tr>
            </>
          ))}
        </tbody>
      </table>
    </div>
    <p class="h2-hint" style="margin-top:12px">Passe o mouse no <code>i</code> de cada coluna para ver o que ela mede. Clique numa linha para ver exemplos reais das respostas do modelo.</p>
  </section>

  <section class="faixa" aria-labelledby="h-achados">
    <h2 id="h-achados">Principais achados</h2>
    <p class="h2-hint">O que a rodada mostra, em condição fechada. Resultados preliminares: a validação humana por amostra acontece antes da publicação 1.0.</p>
    <ol class="achados">
      <li><strong>Alucinar é a regra, não a exceção.</strong> Na transcrição, os modelos acertaram o texto oficial em apenas {pct(mediaFiel)} das vezes e o inventaram em {pct(mediaAluc)}. E negaram {pct(mediaNegaReais)} dos códigos que existem de verdade.</li>
      <li><strong>Quase ninguém diz "não sei".</strong> Foram {m.abstencoes_a === 1 ? 'uma única abstenção' : `${m.abstencoes_a} abstenções`} em {m.total_respostas.toLocaleString('pt-BR')} respostas. O comportamento padrão é responder com confiança, mesmo errado.</li>
      <li><strong>O intervalo entre modelos é enorme.</strong> Da nota {nota(primeiro.nota)} ({primeiro.nome}) à {nota(ultimo.nota)} ({ultimo.nome}). Mesmo o líder aceita {pct(primeiro.invencao_pura)} de códigos inventados como reais.</li>
      <li><strong>Conteúdo mais recente é o ponto fraco.</strong> A alucinação salta de {pct(recModulo['BNCC 2018'])} na BNCC de 2018 para {pct(recModulo['Computação 2022'])} no complemento de Computação de 2022, e cresce da Educação Infantil ({pct(recEtapa['Infantil'])}) ao Ensino Médio ({pct(recEtapa['Médio'])}). Quanto mais novo o conteúdo, mais o modelo inventa, e mais uma fonte estruturada importa.</li>
      <li><strong>Marca e preço não são garantia.</strong> Uma mesma fabricante aparece no pódio e na metade de baixo da tabela; modelos econômicos e caros se misturam no ranking. O nome do modelo não prediz se ele conhece a BNCC.</li>
    </ol>
  </section>

  <section class="faixa" aria-labelledby="h-tabela">
    <h2 id="h-tabela">As cinco dimensões da nota</h2>
    <p class="h2-hint hint-tabela">A nota composta corresponde à média de cinco dimensões: reconhecimento de códigos reais, recusa de códigos inexistentes, fidelidade de transcrição, recuperação de código a partir do texto e citação espontânea com texto correto. A métrica de <strong>invenção pura</strong> contabiliza apenas a aceitação de códigos ausentes de qualquer fonte, oficial ou derivada; a <strong>confusão-derivado</strong> é medida à parte e cobre códigos inexistentes na BNCC, porém presentes em currículos dela derivados. Observação da rodada: em {m.total_respostas.toLocaleString('pt-BR')} respostas, registrou-se <strong>{m.abstencoes_a === 1 ? 'uma única abstenção' : `${m.abstencoes_a} abstenções`}</strong>, na tarefa de transcrição. Nenhum modelo demonstra a disposição de responder "não sei".</p>
  </section>

  <section class="faixa" aria-labelledby="h-metodo">
    <h2 id="h-metodo">Protocolo de medição</h2>
    <p class="h2-hint hint-tabela">Cada <strong>item</strong> é uma pergunta de teste sobre a BNCC (por exemplo: se um código existe, ou qual é o texto oficial de uma habilidade). Foram {m.total_itens} itens, e cada um foi apresentado de três formas diferentes (as <strong>formulações</strong>, para o resultado não depender de como a pergunta é redigida) a {m.total_modelos} modelos, em <strong>condição fechada</strong>, ou seja, sem deixar o modelo consultar nenhuma fonte externa. O total são {m.total_respostas.toLocaleString('pt-BR')} respostas, cada uma julgada, uma a uma, contra o gabarito verificado.</p>
    <ul class="garantias">
      <li><strong>Condição sem ferramenta:</strong> a medição isola a memória do modelo, sem consulta a fonte externa. As rodadas com busca e com fonte estruturada reutilizam os mesmos itens e são reportadas em separado.</li>
      <li><strong>Gabarito verificado:</strong> o padrão de referência são as 1.721 aprendizagens do dataset, conferidas contra os documentos homologados do MEC.</li>
      <li><strong>Verificação anti-vexame dos falsos:</strong> cada código falso foi checado individualmente, com adjudicação humana registrada; um código ausente da BNCC mas presente em currículo derivado é contabilizado à parte, como confusão-derivado.</li>
      <li><strong>Julgamento auditável:</strong> o juiz automático registra cada decisão, item a item. A validação humana por amostra, pela Equipe Pedagógica, está prevista antes da publicação 1.0.</li>
      <li><strong>Determinismo:</strong> temperatura 0 e versões pinadas; cada resposta carrega o checkpoint do modelo, a rota que a serviu e a data.</li>
      <li><strong>Truncamentos não penalizam:</strong> respostas cortadas por limite técnico são registradas como artefato de execução e ficam fora das taxas.</li>
    </ul>
  </section>

  <section class="faixa" aria-labelledby="h-respostas">
    <h2 id="h-respostas">Amostra das respostas cruas</h2>
    <p class="h2-hint">Cada cartão reproduz uma resposta real da rodada, com o julgamento atribuído. Os arquivos completos (as {m.total_respostas.toLocaleString('pt-BR')} respostas, com prompt, tokens e custo por chamada) serão publicados com a versão 1.0 do dataset.</p>

    <div class="filtro-bar">
      <select id="filtro-modelo" aria-label="Filtrar por modelo">
        <option value="">Todos os modelos</option>
        {b.modelos.map((mod) => <option value={mod.id}>{mod.nome}</option>)}
      </select>
      <select id="filtro-veredito" aria-label="Filtrar por julgamento">
        <option value="">Todos os julgamentos</option>
        <option value="ruim">Só erros</option>
        <option value="ok">Só acertos</option>
      </select>
    </div>

    <div class="respostas" id="lista-amostras">
      {b.amostras.map((a) => (
        <div class="resp-card" data-modelo={a.modelo} data-ok={a.ok ? 'ok' : 'ruim'}>
          <div class="resp-head">
            <span class="resp-id mono">{a.item_id} · formulação {a.parafrase + 1}</span>
            <span class="resp-modelo">{a.nome_modelo}</span>
            <span class="resp-tarefa">tarefa {a.tarefa} · {NOME_TAREFA[a.tarefa]}</span>
            <span class:list={['resp-veredito', a.ok ? 'ok' : 'ruim']}>{a.veredito.replaceAll('_', ' ')}</span>
          </div>
          <p class="resp-pergunta">"{a.pergunta}"</p>
          <p class:list={['resp-texto', { destaque: !a.ok }]}>"{a.resposta}"</p>
        </div>
      ))}
    </div>
    <p class="h2-hint" id="sem-amostras" style="display:none; margin-top:12px">Nenhuma amostra com esse filtro.</p>
  </section>

  <section class="faixa" aria-labelledby="h-fecho">
    <h2 id="h-fecho">Limitações e próximos passos</h2>
    <div class="heldout">
      <strong>Held-out privado.</strong> Uma fração dos itens não é publicada, aqui ou no repositório. Serve para distinguir, em remedições futuras, aprendizado real da BNCC de memorização deste benchmark: se as taxas públicas melhorarem sem o held-out acompanhar, o ganho foi memorização do teste.
    </div>
    <ol class="proximos">
      <li><strong>Rodadas com ferramenta.</strong> A mesma bateria com busca web e com fonte estruturada (bncc.dev), para medir quanto o acesso à fonte derruba a alucinação.</li>
      <li><strong>Validação humana.</strong> Amostra das respostas julgada pela Equipe Pedagógica, antes da publicação 1.0.</li>
      <li><strong>Publicação completa.</strong> Repositório público e os arquivos brutos das {m.total_respostas.toLocaleString('pt-BR')} respostas, na release <code>dados-v1.0.0</code>.</li>
      <li><strong>Remedição contínua.</strong> Reexecução quando surgir um modelo novo relevante, com o held-out separando aprendizado real de memorização do teste.</li>
    </ol>
  </section>

  <script type="application/json" id="amostras-json" set:html={JSON.stringify(amostrasPorModelo)}></script>

  <div class="drawer-fundo" id="drawer-fundo"></div>
  <aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-nome">
    <div class="drawer-cabecalho">
      <div class="drawer-titulo">
        <span class="rotulo">Amostra bruta · JSON</span>
        <span class="nome" id="drawer-nome"></span>
      </div>
      <button class="drawer-fechar" id="drawer-fechar" type="button" aria-label="Fechar">×</button>
    </div>
    <div class="drawer-corpo">
      <pre id="drawer-conteudo"></pre>
      <p class="drawer-nota" id="drawer-nota"></p>
    </div>
  </aside>
</Base>

