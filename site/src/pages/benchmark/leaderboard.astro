<script is:inline>
  // expansão das linhas da tabela (mesma interação do restante do site: sem framework)
  document.querySelectorAll('.linha-modelo').forEach((linha) => {
    linha.addEventListener('click', () => {
      const botao = linha.querySelector('.btn-expandir');
      const detalhe = document.getElementById(linha.dataset.alvo);
      const aberto = botao.getAttribute('aria-expanded') === 'true';
      botao.setAttribute('aria-expanded', String(!aberto));
      linha.classList.toggle('aberta', !aberto);
      detalhe.classList.toggle('aberta', !aberto);
    });
  });

  // seletor de tarefa na ficha "Perfil deste modelo" (A/C/D)
  document.querySelectorAll('.ficha-sel').forEach((sel) => {
    sel.addEventListener('change', () => {
      const bloco = sel.closest('.ficha-bloco');
      bloco.querySelectorAll('.tarefa-vis').forEach((vis) => {
        vis.classList.toggle('oculto', vis.dataset.tarefa !== sel.value);
      });
    });
  });

  // filtros da amostra de respostas
  const filtroModelo = document.getElementById('filtro-modelo');
  const filtroVeredito = document.getElementById('filtro-veredito');
  const cards = [...document.querySelectorAll('#lista-amostras .resp-card')];
  function filtrar() {
    let visiveis = 0;
    for (const card of cards) {
      const okModelo = !filtroModelo.value || card.dataset.modelo === filtroModelo.value;
      const okVeredito = !filtroVeredito.value || card.dataset.ok === filtroVeredito.value;
      const mostrar = okModelo && okVeredito;
      card.style.display = mostrar ? '' : 'none';
      if (mostrar) visiveis++;
    }
    document.getElementById('sem-amostras').style.display = visiveis ? 'none' : '';
  }
  filtroModelo.addEventListener('change', filtrar);
  filtroVeredito.addEventListener('change', filtrar);

  // drawer lateral com o JSON bruto das amostras reais por modelo
  const amostrasPorModelo = JSON.parse(document.getElementById('amostras-json').textContent || '{}');
  const drawer = document.getElementById('drawer');
  const drawerFundo = document.getElementById('drawer-fundo');
  const drawerNome = document.getElementById('drawer-nome');
  const drawerConteudo = document.getElementById('drawer-conteudo');
  const drawerNota = document.getElementById('drawer-nota');
  const TOTAL_POR_MODELO = 900;
  let ultimoFoco = null;

  function abrirDrawer(modeloId, nome, origem) {
    const amostras = amostrasPorModelo[modeloId] || [];
    ultimoFoco = origem;
    drawerNome.textContent = `brutos-${modeloId}-seco.jsonl`;
    // formato JSONL: uma resposta real por linha, como no arquivo bruto
    drawerConteudo.textContent = amostras.map((linha) => JSON.stringify(linha)).join('\n');
    drawerNota.innerHTML = `Mostrando <strong>${amostras.length}</strong> de ${TOTAL_POR_MODELO.toLocaleString('pt-BR')} respostas de <strong>${nome}</strong>. O arquivo bruto completo será publicado junto com o dataset 1.0.`;
    drawerFundo.classList.add('aberta');
    drawer.classList.add('aberta');
    document.getElementById('drawer-fechar').focus();
    document.body.style.overflow = 'hidden';
  }

  function fecharDrawer() {
    drawerFundo.classList.remove('aberta');
    drawer.classList.remove('aberta');
    document.body.style.overflow = '';
    if (ultimoFoco) ultimoFoco.focus();
  }

  document.querySelectorAll('.ver-bruto').forEach((botao) => {
    botao.addEventListener('click', (ev) => {
      ev.stopPropagation(); // não deixa o clique fechar a linha expandida
      abrirDrawer(botao.dataset.modelo, botao.dataset.nome, botao);
    });
  });
  document.getElementById('drawer-fechar').addEventListener('click', fecharDrawer);
  drawerFundo.addEventListener('click', fecharDrawer);
  document.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape' && drawer.classList.contains('aberta')) fecharDrawer();
  });
</script>

<style>
  .selo-vermelho { color: var(--erro-ink); background: var(--erro-bg); border-color: var(--erro); }
  .versao-label { display: inline-block; font-family: var(--mono); font-size: 11.5px; color: var(--ink-muted); background: var(--bg-subtle); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; margin: 0 0 14px 6px; }
  h1.abre { font-size: 30px; font-weight: 700; letter-spacing: -.02em; line-height: 1.16; margin: 0 0 12px; text-wrap: balance; }

  .cabecalho { display: grid; grid-template-columns: minmax(0, 1fr) minmax(232px, 288px); gap: 32px; align-items: start; margin-bottom: 8px; }
  .cabecalho-texto .abre-sub { max-width: 62ch; }

  .metadados { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--bg-subtle); }
  .md-item { padding: 11px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .md-item:last-child { border-bottom: 0; }
  .md-item .md-k { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted); font-weight: 600; }
  .md-item .md-v { font-family: var(--mono); font-size: 13px; font-weight: 600; text-align: right; }

  section.faixa { padding: 32px 0 0; margin-top: 32px; }
  section.faixa > h2 { font-size: 19px; font-weight: 700; letter-spacing: -.015em; margin: 0 0 6px; }
  section.faixa .h2-hint { font-size: 13px; margin: 0 0 18px; max-width: 74ch; line-height: 1.6; }

  section.faixa-tabela { border-top: 0; padding-top: 0; margin-top: 32px; }
  section.faixa .hint-tabela { font-size: 14.5px; max-width: none; }

  .rolagem { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); }
  table { border-collapse: collapse; width: 100%; font-size: 12.5px; min-width: 860px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  thead th { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted); background: var(--bg-subtle); position: sticky; top: 0; }
  tbody tr:hover { background: var(--bg-subtle); }
  td.num, th.num { text-align: right; font-family: var(--mono); font-variant-numeric: tabular-nums; }
  td.rank { color: var(--ink-muted); font-family: var(--mono); }
  td.modelo { font-weight: 650; }
