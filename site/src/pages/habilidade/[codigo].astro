---
import Base from '../../layouts/Base.astro';
import PaginaAprendizagem from '../../components/PaginaAprendizagem.astro';
import PaginaAprendizagemComputacao from '../../components/PaginaAprendizagemComputacao.astro';
import {
  breadcrumbAprendizagem, breadcrumbJsonLd, habilidadesEF, habilidadesEM,
  jsonLd, metaDescricao, porCodigo,
} from '../../lib/dados';
import {
  aprendizagensCO, breadcrumbCO, ehComputacao, jsonLdCO, metaDescricaoCO, porCodigoCO,
} from '../../lib/computacao';

export function getStaticPaths() {
  return [
    ...[...habilidadesEF(), ...habilidadesEM()].map((h) => ({ params: { codigo: h.codigo } })),
    ...aprendizagensCO().filter((a) => a.etapa !== 'EI').map((a) => ({ params: { codigo: a.codigo } })),
  ];
}

const codigo = Astro.params.codigo!;
const url = new URL(Astro.url.pathname, Astro.site).href;

let titulo: string, descricao: string, schemas: object[], co = false;
if (ehComputacao(codigo)) {
  co = true;
  const reg = porCodigoCO(codigo)!;
  titulo = reg.etapa === 'EF'
    ? `${codigo} · Computação · ${reg.anos!.map((a) => `${a}º`).join(' e ')} ano · habilidade do complemento à BNCC`
    : `${codigo} · Computação · Ensino Médio · habilidade do complemento à BNCC`;
  descricao = metaDescricaoCO(reg);
  schemas = [jsonLdCO(reg, url), breadcrumbJsonLd(breadcrumbCO(reg))];
} else {
  const reg = porCodigo(codigo);
  titulo = reg.etapa === 'EF'
    ? `${reg.codigo} · ${reg.componente!.nome} · ${reg.anos!.map((a) => `${a}º`).join(' e ')} ano · habilidade da BNCC`
    : `${reg.codigo} · ${reg.componente?.nome ?? reg.area!.nome} · Ensino Médio · habilidade da BNCC`;
  descricao = metaDescricao(reg);
  schemas = [jsonLd(reg, url), breadcrumbJsonLd(breadcrumbAprendizagem(reg))];
}
---
<Base titulo={titulo} descricao={descricao} etapa={co ? undefined : porCodigo(codigo).etapa} ogType="article" jsonLd={schemas}>
  {co ? <PaginaAprendizagemComputacao reg={porCodigoCO(codigo)!} /> : <PaginaAprendizagem reg={porCodigo(codigo)} />}
</Base>
