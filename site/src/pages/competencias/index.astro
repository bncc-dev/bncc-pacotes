---
import Base from '../../layouts/Base.astro';
import { competenciasEspecificas, estrutura } from '../../lib/dados';

const gerais = estrutura().competencias_gerais;
const especificas = competenciasEspecificas();
const grupos = new Map<string, typeof especificas>();
for (const ce of especificas) {
  const chave = `${ce.contexto.rotulo}: ${ce.contexto.nome}`;
  if (!grupos.has(chave)) grupos.set(chave, []);
  grupos.get(chave)!.push(ce);
}
---
<Base titulo="Competências da BNCC: as 10 gerais e as 105 específicas · bncc.dev"
      descricao="As 10 competências gerais da Educação Básica e as 105 competências específicas de área e de componente da BNCC, com as habilidades vinculadas.">
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li>Competências</li>
  </nav>
  <h1 class="titulo-secao">Competências da BNCC</h1>
  <p class="h2-hint">A Base define 10 competências gerais para toda a Educação Básica e 105 competências específicas (de área e de componente). No Ensino Médio, cada habilidade se vincula oficialmente a uma competência específica da área; no Fundamental esse vínculo não existe no documento, e nós não o inventamos.</p>

  <section aria-labelledby="h-gerais">
    <h2 id="h-gerais">As 10 competências gerais da Educação Básica</h2>
    <ol class="lista-competencias">
      {gerais.map((cg: any) => (
        <li id={cg.id}>
          <span class="cod">{cg.numero}</span>
          <p>{cg.texto}</p>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="h-especificas">
    <h2 id="h-especificas">As 105 competências específicas</h2>
    {[...grupos.entries()].map(([chave, ces]) => (
      <details class="grupo-ce">
        <summary>{chave} <span class="qtd-ce">{ces.length} competências</span></summary>
        <ul class="lista">
          {ces.map((ce) => (
            <li><a href={`/competencia/${ce.id}/`}>
              <span class="cod">CE {ce.numero}</span>
              <span class="resumo">{ce.texto.length > 140 ? ce.texto.slice(0, 137) + '…' : ce.texto}</span>
            </a></li>
          ))}
        </ul>
      </details>
    ))}
  </section>
</Base>
