---
import Base from '../layouts/Base.astro';
import { estatisticas } from '../lib/dados';
const s = estatisticas();
---
<Base titulo="Página não encontrada · bncc.dev"
      descricao="Esta página não existe no bncc.dev. Se você chegou por um código de habilidade, ele não existe na BNCC: a numeração tem lacunas legítimas.">
  <h1 class="titulo-secao">Esta página não existe</h1>

  <div class="texto-oficial" id="nao-existe-codigo" hidden>
    <p><strong id="codigo-tentado" class="mono"></strong> não existe na BNCC. Isto não é um erro do site:
    a numeração oficial tem lacunas legítimas, e este site só publica o que está no documento homologado.
    Se uma IA ou um material citou esse código, a citação está incorreta.</p>
  </div>

  <p class="subtitulo" id="nao-existe-generico">
    O endereço pode ter mudado ou nunca ter existido. Se você procurava um código de habilidade,
    vale saber: se ele não está no bncc.dev, ele não existe na BNCC (a numeração tem lacunas legítimas).
  </p>

  <section class="bloco">
    <h2>Por onde continuar</h2>
    <ul class="lista">
      <li><a href="/buscar/"><span class="cod">Buscar</span><span class="resumo">por código ou por tema, nas {s.total.toLocaleString('pt-BR')} aprendizagens oficiais</span></a></li>
      <li><a href="/infantil/"><span class="cod">Infantil</span><span class="resumo">{s.educacaoInfantil} objetivos por campo de experiências</span></a></li>
      <li><a href="/fundamental/"><span class="cod">Fundamental</span><span class="resumo">{s.ensinoFundamental.toLocaleString('pt-BR')} habilidades por componente e ano</span></a></li>
      <li><a href="/medio/"><span class="cod">Médio</span><span class="resumo">{s.ensinoMedio} habilidades por área do conhecimento</span></a></li>
      <li><a href="/computacao/"><span class="cod">Computação</span><span class="resumo">o complemento à BNCC (Parecer CNE/CEB 2/2022), com 141 aprendizagens</span></a></li>
      <li><a href="/competencias/"><span class="cod">Competências</span><span class="resumo">as 10 gerais e as {s.competenciasEspecificas} específicas</span></a></li>
    </ul>
  </section>
</Base>

<script is:inline>
  // Se o caminho parece um código BNCC (ex.: /habilidade/EF67LP99/), personaliza a
  // mensagem: dizer com todas as letras que o código não existe é anti-alucinação.
  const m = location.pathname.match(/\/(?:habilidade|objetivo)\/([A-Z0-9]+)\/?$/i);
  if (m) {
    const codigo = m[1].toUpperCase();
    const eCodigo = /^(EI0[123](EO|CG|TS|EF|ET|CO)\d{2}|EF\d{2}[A-Z]{2}\d{2}|EM13[A-Z]{2,3}\d{2,3})$/.test(codigo);
    document.getElementById('codigo-tentado').textContent = codigo + (eCodigo ? '' : ' (nem sequer é um código válido no formato da BNCC)');
    document.getElementById('nao-existe-codigo').hidden = false;
    document.getElementById('nao-existe-generico').hidden = true;
  }
</script>
