---
import Base from '../layouts/Base.astro';
import { breadcrumbJsonLd, organizacaoJsonLd, urlAbsoluta } from '../lib/dados';

const TURNSTILE_SITE_KEY = '0x4AAAAAAD0dhvnYRmtRxGis'; // site key pública do widget bnccdev
const CONTATO_API = 'https://contato.bncc.dev';

const urlIssue = 'https://github.com/bncc-dev/bncc-dados/issues/new?title=' +
  encodeURIComponent('Possível erro em um dado') + '&body=' +
  encodeURIComponent('Registro (código): \nO que parece errado:\nFonte oficial que sustenta a correção (obrigatória):');

const contatoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contato · bncc.dev',
  url: urlAbsoluta('/contato/'),
  inLanguage: 'pt-BR',
  publisher: {
    ...organizacaoJsonLd(),
    contactPoint: { '@type': 'ContactPoint', contactType: 'contato geral', email: 'contato@bncc.dev', availableLanguage: 'pt-BR' },
  },
};
---
<Base titulo="Contato · bncc.dev"
      descricao="Fale com a equipe do bncc.dev: parcerias, imprensa, dúvidas e sugestões pelo formulário ou por contato@bncc.dev. Correções de dados têm canal próprio e auditável no GitHub."
      jsonLd={[breadcrumbJsonLd([{ nome: 'contato', url: '/contato/' }]), contatoJsonLd]}>

  <div class="miolo-contato">
    <ol class="trilha">
      <li><a href="/">bncc.dev</a></li>
      <li>contato</li>
    </ol>

    <h1 class="titulo-secao">Fale com a equipe</h1>
    <p class="subtitulo">Lemos tudo. Para correção de dados existe um canal próprio e auditável; para o resto, o formulário abaixo chega direto na caixa da equipe.</p>

    <div class="triagem">
      <a class="rota" href={urlIssue} target="_blank" rel="noopener">
        <span class="p">Achou erro em um dado?</span>
        <span class="d">Correções passam pelo canal público, com referência à fonte oficial: cada ajuste fica registrado e auditável no repositório.</span>
        <span class="g">abrir uma issue no GitHub →</span>
      </a>
      <div class="rota ativa">
        <span class="p">Parceria, imprensa, dúvida, sugestão?</span>
        <span class="d">Use o formulário abaixo. Chega em contato@bncc.dev e respondemos pelo e-mail que você informar.</span>
        <span class="g">↓ é logo aqui</span>
      </div>
    </div>

    <form class="form-contato" id="form-contato" novalidate>
      <div class="dupla">
        <div class="campo">
          <label for="f-nome">Seu nome</label>
          <input id="f-nome" name="nome" type="text" required maxlength="120" autocomplete="name" />
        </div>
        <div class="campo">
          <label for="f-email">Seu e-mail <span class="opcional">· para a resposta</span></label>
          <input id="f-email" name="email" type="email" required maxlength="200" autocomplete="email" />
        </div>
      </div>
      <div class="campo">
        <label for="f-assunto">Assunto</label>
        <select id="f-assunto" name="assunto">
          <option value="duvida">Dúvida sobre o projeto ou os dados</option>
          <option value="parceria">Parceria ou uso institucional</option>
          <option value="imprensa">Imprensa</option>
          <option value="outro">Outro</option>
        </select>
      </div>
      <div class="campo">
        <label for="f-mensagem">Mensagem</label>
        <textarea id="f-mensagem" name="mensagem" required maxlength="4000"></textarea>
      </div>
      {/* honeypot: humanos não veem; robôs preenchem e o Worker descarta */}
      <div class="hp" aria-hidden="true">
        <label for="f-site">Deixe este campo vazio</label>
        <input id="f-site" name="site" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
      <div class="form-acao">
        <button class="btn-enviar" type="submit">Enviar mensagem</button>
        <span class="form-status" id="form-status" role="status" aria-live="polite"></span>
      </div>
    </form>

    <p class="pledge"><strong>Prefere e-mail direto</strong> (ou o formulário falhou)? Escreva para <a href="mailto:contato@bncc.dev"><code>contato@bncc.dev</code></a>. É o mesmo destino.</p>
  </div>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline define:vars={{ CONTATO_API }}>
  const form = document.getElementById('form-contato');
  const status = document.getElementById('form-status');
  const btn = form.querySelector('.btn-enviar');
  const FALLBACK = 'Não deu certo agora. Escreva para contato@bncc.dev: é o mesmo destino.';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    btn.disabled = true;
    status.className = 'form-status';
    status.textContent = 'enviando…';
    const dados = {
      nome: form.nome.value,
      email: form.email.value,
      assunto: form.assunto.value,
      mensagem: form.mensagem.value,
      site: form.site.value,
      token: form.querySelector('[name="cf-turnstile-response"]')?.value ?? '',
    };
    try {
      const r = await fetch(CONTATO_API, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(dados),
      });
      const corpo = await r.json().catch(() => ({}));
      if (r.ok && corpo.ok) {
        status.className = 'form-status ok';
        status.textContent = 'Mensagem enviada ✓ · respondemos no seu e-mail';
        form.reset();
      } else {
        status.className = 'form-status erro';
        status.textContent = corpo.dica ? `${corpo.erro} ${corpo.dica}` : FALLBACK;
      }
    } catch {
      status.className = 'form-status erro';
      status.textContent = FALLBACK;
    }
    window.turnstile?.reset();
    btn.disabled = false;
  });
</script>
