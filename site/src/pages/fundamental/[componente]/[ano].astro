---
import Base from '../../../layouts/Base.astro';
import { breadcrumbJsonLd, estrutura, habilidadesEF, rotaDe } from '../../../lib/dados';
import { aprendizagensCO } from '../../../lib/computacao';

export function getStaticPaths() {
  const caminhos: Array<{ params: { componente: string; ano: string } }> = [];
  for (const c of estrutura().componentes_curriculares.filter((c) => c.etapa === 'EF')) {
    const slug = c.id.replace('ef-comp-', '');
    const anos = [...new Set(habilidadesEF({ componente: c.id }).flatMap((h) => h.anos!))];
    for (const ano of anos) caminhos.push({ params: { componente: slug, ano: String(ano) } });
  }
  return caminhos;
}

const id = `ef-comp-${Astro.params.componente}`;
const ano = Number(Astro.params.ano);
const comp = estrutura().componentes_curriculares.find((c) => c.id === id)!;
const habs = habilidadesEF({ componente: id, ano });
const coDoAno = aprendizagensCO().filter((a) => a.etapa === 'EF' && a.anos!.length === 1 && a.anos![0] === ano).length;
const coDoBloco = aprendizagensCO().filter((a) => a.codigo.startsWith(ano <= 5 ? 'EF15' : 'EF69')).length;
---
<Base titulo={`${comp.nome} · ${ano}º ano · ${habs.length} habilidades da BNCC · bncc.dev`} etapa="EF"
      descricao={`As ${habs.length} habilidades de ${comp.nome} do ${ano}º ano do Ensino Fundamental na BNCC.`}
      jsonLd={breadcrumbJsonLd([
        { nome: 'Ensino Fundamental', url: '/fundamental/' },
        { nome: comp.nome, url: `/fundamental/${Astro.params.componente}/` },
        { nome: `${ano}º ano` },
      ])}>
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li><a href="/fundamental/">Ensino Fundamental</a></li>
    <li><a href={`/fundamental/${Astro.params.componente}/`}>{comp.nome}</a></li>
    <li>{ano}º ano</li>
  </nav>
  <div class="cabecalho-listagem">
    <h1 class="titulo-secao">{comp.nome} · {ano}º ano</h1>
    <p class="acoes-listagem"><a class="btn" href={`/csv/fundamental-${Astro.params.componente}-${ano}ano.csv`} download><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>Download CSV desta listagem</a></p>
  </div>
  <ul class="lista">
    {habs.map((h) => (
      <li><a href={rotaDe(h.codigo)}>
        <span class="cod">{h.codigo}</span>
        <span class="resumo">{h.texto.length > 140 ? h.texto.slice(0, 137) + '…' : h.texto}</span>
      </a></li>
    ))}
  </ul>
  <section class="bloco" aria-labelledby="h-co-ano">
    <h2 id="h-co-ano">Este ano também tem</h2>
    <ul class="lista">
      <li><a href={`/computacao/#ef-${ano}-ano`}>
        <span class="cod">CO</span>Complemento de Computação
        <span class="resumo"> · {coDoAno} habilidades do {ano}º ano e {coDoBloco} do bloco {ano <= 5 ? '1º ao 5º' : '6º ao 9º'} (Parecer CNE/CEB 2/2022)</span>
      </a></li>
    </ul>
  </section>
</Base>
