---
import Base from '../../../layouts/Base.astro';
import { breadcrumbJsonLd, estrutura, habilidadesEF } from '../../../lib/dados';

export function getStaticPaths() {
  return estrutura().componentes_curriculares
    .filter((c) => c.etapa === 'EF')
    .map((c) => ({ params: { componente: c.id.replace('ef-comp-', '') } }));
}

const id = `ef-comp-${Astro.params.componente}`;
const comp = estrutura().componentes_curriculares.find((c) => c.id === id)!;
const habs = habilidadesEF({ componente: id });
const anos = [...new Set(habs.flatMap((h) => h.anos!))].sort((a, b) => a - b);
---
<Base titulo={`${comp.nome} · Ensino Fundamental · ${habs.length} habilidades da BNCC · bncc.dev`} etapa="EF"
      descricao={`As ${habs.length} habilidades de ${comp.nome} no Ensino Fundamental, por ano, com texto oficial verificado.`}
      jsonLd={breadcrumbJsonLd([{ nome: 'Ensino Fundamental', url: '/fundamental/' }, { nome: comp.nome }])}>
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li><a href="/fundamental/">Ensino Fundamental</a></li>
    <li>{comp.nome}</li>
  </nav>
  <div class="cabecalho-listagem">
    <h1 class="titulo-secao">{comp.nome}</h1>
    <p class="acoes-listagem"><a class="btn" href={`/csv/fundamental-${Astro.params.componente}.csv`} download><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>Download CSV desta listagem</a></p>
  </div>
  <p class="subtitulo">{habs.length} habilidades. Por ano:</p>
  <ul class="lista">
    {anos.map((ano) => (
      <li><a href={`/fundamental/${Astro.params.componente}/${ano}/`}>
        <span class="cod">{ano}º ano</span>
        <span class="resumo">{habs.filter((h) => h.anos!.includes(ano)).length} habilidades</span>
      </a></li>
    ))}
  </ul>
</Base>
