---
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, estrutura, habilidadesEM, rotaDe } from '../../lib/dados';
import { estatisticasCO } from '../../lib/computacao';

export function getStaticPaths() {
  return estrutura().areas_conhecimento
    .filter((a) => a.etapa === 'EM')
    .map((a) => ({ params: { area: a.id.replace('em-area-', '') } }));
}

const id = `em-area-${Astro.params.area}`;
const area = estrutura().areas_conhecimento.find((a) => a.id === id)!;
const habs = habilidadesEM({ area: id });
---
<Base titulo={`${area.nome} · Ensino Médio · ${habs.length} habilidades da BNCC · bncc.dev`} etapa="EM"
      descricao={`As ${habs.length} habilidades de ${area.nome} no Ensino Médio da BNCC, com competências vinculadas.`}
      jsonLd={breadcrumbJsonLd([{ nome: 'Ensino Médio', url: '/medio/' }, { nome: area.nome }])}>
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li><a href="/medio/">Ensino Médio</a></li>
    <li>{area.nome}</li>
  </nav>
  <h1 class="titulo-secao">{area.nome}</h1>
  <p class="acoes-listagem"><a class="btn" href={`/csv/medio-${Astro.params.area}.csv`} download>baixar CSV desta listagem</a></p>
  <ul class="lista">
    {habs.map((h) => (
      <li><a href={rotaDe(h.codigo)}>
        <span class="cod">{h.codigo}</span>
        <span class="resumo">{h.texto.length > 140 ? h.texto.slice(0, 137) + '…' : h.texto}</span>
      </a></li>
    ))}
  </ul>
  <section class="bloco" aria-labelledby="h-co-em">
    <h2 id="h-co-em">O Ensino Médio também tem</h2>
    <ul class="lista">
      <li><a href="/computacao/#medio">
        <span class="cod">CO</span>Complemento de Computação
        <span class="resumo"> · {estatisticasCO().em} habilidades por competência específica (Parecer CNE/CEB 2/2022)</span>
      </a></li>
    </ul>
  </section>
</Base>
