---
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, estrutura, habilidadesEM } from '../../lib/dados';
const areas = estrutura().areas_conhecimento.filter((a) => a.etapa === 'EM');
const total = habilidadesEM().length;
---
<Base titulo={`Ensino Médio · ${total} habilidades da BNCC · bncc.dev`} etapa="EM"
      descricao={`As ${total} habilidades do Ensino Médio na BNCC, por área do conhecimento, com competências vinculadas e texto oficial verificado.`}
      jsonLd={breadcrumbJsonLd([{ nome: 'Ensino Médio' }])}>
  <nav class="trilha"><li><a href="/">bncc.dev</a></li><li>Ensino Médio</li></nav>
  <div class="cabecalho-listagem">
    <h1 class="titulo-secao">Ensino Médio</h1>
    <p class="acoes-listagem"><a class="btn" href="/csv/medio.csv" download><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"/><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"/></svg>Download CSV da etapa completa</a></p>
  </div>
  <p class="subtitulo">4 áreas do conhecimento, sem seriação (a progressão é definida pelos currículos). Escolha uma área:</p>
  <ul class="lista">
    {areas.map((a) => (
      <li><a href={`/medio/${a.id.replace('em-area-', '')}/`}>
        {a.nome}
        <span class="resumo"> · {habilidadesEM({ area: a.id }).length} habilidades</span>
      </a></li>
    ))}
  </ul>

  <section class="bloco" aria-labelledby="h-co">
    <h2 id="h-co">Além da BNCC 2018</h2>
    <ul class="lista">
      <li><a href="/computacao/#medio">
        <span class="cod">CO</span>Complemento de Computação
        <span class="resumo"> · 26 habilidades por competência específica (Parecer CNE/CEB 2/2022)</span>
      </a></li>
    </ul>
  </section>
</Base>
