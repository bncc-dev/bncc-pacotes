---
import Base from '../../layouts/Base.astro';
import { breadcrumbJsonLd, estrutura, objetivosEI } from '../../lib/dados';
const campos = estrutura().campos_experiencias;
const total = objetivosEI().length;
---
<Base titulo={`Educação Infantil · ${total} objetivos da BNCC · bncc.dev`} etapa="EI"
      descricao={`Os ${total} objetivos de aprendizagem e desenvolvimento da Educação Infantil na BNCC, por campo de experiências e faixa etária.`}
      jsonLd={breadcrumbJsonLd([{ nome: 'Educação Infantil' }])}>
  <nav class="trilha"><li><a href="/">bncc.dev</a></li><li>Educação Infantil</li></nav>
  <h1 class="titulo-secao">Educação Infantil</h1>
  <p class="acoes-listagem"><a class="btn" href="/csv/infantil.csv" download>baixar CSV da etapa completa</a></p>
  <p class="subtitulo">5 campos de experiências, 3 grupos por faixa etária, com a progressão oficial entre as faixas. Escolha um campo:</p>
  <ul class="lista">
    {campos.map((c) => (
      <li><a href={`/infantil/${c.id.replace('ei-campo-', '')}/`}>
        {c.nome}
        <span class="resumo"> · {objetivosEI({ campo: c.id }).length} objetivos</span>
      </a></li>
    ))}
  </ul>

  <section class="bloco" aria-labelledby="h-co">
    <h2 id="h-co">Além da BNCC 2018</h2>
    <ul class="lista">
      <li><a href="/computacao/#infantil">
        <span class="cod">CO</span>Complemento de Computação
        <span class="resumo"> · 11 objetivos para a pré-escola (Parecer CNE/CEB 2/2022)</span>
      </a></li>
    </ul>
  </section>
</Base>
