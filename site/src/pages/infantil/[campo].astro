---
import Base from '../../layouts/Base.astro';
import { GRUPOS_EI_ROTULOS, breadcrumbJsonLd, estrutura, objetivosEI, rotaDe } from '../../lib/dados';
import { estatisticasCO } from '../../lib/computacao';

export function getStaticPaths() {
  return estrutura().campos_experiencias.map((c) => ({ params: { campo: c.id.replace('ei-campo-', '') } }));
}

const id = `ei-campo-${Astro.params.campo}`;
const campo = estrutura().campos_experiencias.find((c) => c.id === id)!;
const grupos = ['ei-grupo-01', 'ei-grupo-02', 'ei-grupo-03'];
const total = objetivosEI({ campo: id }).length;
---
<Base titulo={`${campo.nome} · Educação Infantil · ${total} objetivos da BNCC · bncc.dev`} etapa="EI"
      descricao={`Os ${total} objetivos de aprendizagem do campo de experiências "${campo.nome}" na Educação Infantil da BNCC, por faixa etária.`}
      jsonLd={breadcrumbJsonLd([{ nome: 'Educação Infantil', url: '/infantil/' }, { nome: campo.nome }])}>
  <nav class="trilha">
    <li><a href="/">bncc.dev</a></li>
    <li><a href="/infantil/">Educação Infantil</a></li>
    <li>{campo.nome}</li>
  </nav>
  <h1 class="titulo-secao">{campo.nome}</h1>
  <p class="acoes-listagem"><a class="btn" href={`/csv/infantil-${Astro.params.campo}.csv`} download>baixar CSV desta listagem</a></p>
  {grupos.map((g) => (
    <section class="bloco">
      <h2>{GRUPOS_EI_ROTULOS[g]}</h2>
      <ul class="lista">
        {objetivosEI({ campo: id, grupoEtario: g }).map((o) => (
          <li><a href={rotaDe(o.codigo)}>
            <span class="cod">{o.codigo}</span>
            <span class="resumo">{o.texto}</span>
          </a></li>
        ))}
      </ul>
    </section>
  ))}
  <section class="bloco" aria-labelledby="h-co-ei">
    <h2 id="h-co-ei">A Educação Infantil também tem</h2>
    <ul class="lista">
      <li><a href="/computacao/#infantil">
        <span class="cod">CO</span>Complemento de Computação
        <span class="resumo"> · {estatisticasCO().ei} objetivos para a pré-escola (Parecer CNE/CEB 2/2022)</span>
      </a></li>
    </ul>
  </section>
</Base>
