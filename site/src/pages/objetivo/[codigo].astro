---
import Base from '../../layouts/Base.astro';
import PaginaAprendizagem from '../../components/PaginaAprendizagem.astro';
import {
  GRUPOS_EI_ROTULOS, breadcrumbAprendizagem, breadcrumbJsonLd, jsonLd,
  metaDescricao, objetivosEI, porCodigo,
} from '../../lib/dados';

export function getStaticPaths() {
  return objetivosEI().map((o) => ({ params: { codigo: o.codigo } }));
}

const reg = porCodigo(Astro.params.codigo!);
const grupo = GRUPOS_EI_ROTULOS[reg.grupoEtario!].split(' (')[0];
const titulo = `${reg.codigo} · ${reg.campoExperiencias!.nome} · ${grupo} · objetivo da BNCC`;
---
<Base titulo={titulo} descricao={metaDescricao(reg)} etapa="EI" ogType="article"
      jsonLd={[jsonLd(reg, new URL(Astro.url.pathname, Astro.site).href), breadcrumbJsonLd(breadcrumbAprendizagem(reg))]}>
  <PaginaAprendizagem reg={reg} />
</Base>
