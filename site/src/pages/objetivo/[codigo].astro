---
import Base from '../../layouts/Base.astro';
import PaginaAprendizagem from '../../components/PaginaAprendizagem.astro';
import { jsonLd, metaDescricao, objetivosEI, porCodigo } from '../../lib/dados';

export function getStaticPaths() {
  return objetivosEI().map((o) => ({ params: { codigo: o.codigo } }));
}

const reg = porCodigo(Astro.params.codigo!);
const titulo = `${reg.codigo} · BNCC · ${reg.campoExperiencias!.nome}`;
---
<Base titulo={titulo} descricao={metaDescricao(reg)} etapa="EI"
      jsonLd={jsonLd(reg, new URL(Astro.url.pathname, Astro.site).href)}>
  <PaginaAprendizagem reg={reg} />
</Base>
