---
import '../styles/global.css';
import { ETAPAS, versao } from '../lib/dados';

interface Props {
  titulo: string;
  descricao: string;
  jsonLd?: object | object[];
  /** Etapa da página, quando houver: define a cor do theme-color (linguagem visual da BNCC). */
  etapa?: 'EI' | 'EF' | 'EM';
  /** og:type: 'website' (padrão) ou 'article' nas páginas de detalhe. */
  ogType?: 'website' | 'article';
}
const { titulo, descricao, jsonLd, etapa, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og/bncc-dev.png', Astro.site).href;
const temaCor = etapa ? ETAPAS[etapa].cor : '#1a6e42';
const v = versao();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={temaCor} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="bncc.dev" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="bncc.dev · a BNCC em dados abertos, auditáveis e acessíveis" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // aplica o tema salvo antes do primeiro paint (evita flash)
      const temaSalvo = localStorage.getItem('tema');
      if (temaSalvo) document.documentElement.dataset.theme = temaSalvo;
    </script>
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/">bncc<span class="dot">·</span>dev</a>
      <form class="search" role="search" id="busca-codigo">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/></svg>
        <input type="search" name="q" placeholder="Código ou tema… ex.: EF67LP08" aria-label="Buscar na BNCC por código ou tema" />
        <kbd>/</kbd>
      </form>
      <nav class="topbar-links" aria-label="Navegação principal">
        <a href="/infantil/">Infantil</a>
        <a href="/fundamental/">Fundamental</a>
        <a href="/medio/">Médio</a>
        <a href="/competencias/">Competências</a>
        <a href="/buscar/">Buscar</a>
        <a href="/api/">API</a>
        <a href="/sobre/">Sobre</a>
        <a href="https://github.com/bncc-dev" rel="noopener">GitHub</a>
        <button class="theme-btn" type="button" id="alternar-tema" aria-label="Alternar entre tema claro e escuro" title="Tema claro/escuro">
          <svg id="icone-sol" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true" style="display:none"><path d="M8 10.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-11a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 1Zm0 12a.75.75 0 0 1 .75.75v1a.75.75 0 0 1-1.5 0v-1A.75.75 0 0 1 8 13Zm7-5a.75.75 0 0 1-.75.75h-1a.75.75 0 0 1 0-1.5h1A.75.75 0 0 1 15 8ZM3.5 8a.75.75 0 0 1-.75.75h-1a.75.75 0 0 1 0-1.5h1A.75.75 0 0 1 3.5 8Zm8.8-4.95a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 1 1-1.07-1.06l.71-.7a.75.75 0 0 1 1.06 0ZM5.46 10.54a.75.75 0 0 1 0 1.06l-.7.7a.75.75 0 0 1-1.07-1.06l.71-.7a.75.75 0 0 1 1.06 0Zm7.9 1.76a.75.75 0 0 1-1.06 0l-.7-.7a.75.75 0 1 1 1.06-1.07l.7.71a.75.75 0 0 1 0 1.06ZM5.46 5.46a.75.75 0 0 1-1.06 0l-.7-.7a.75.75 0 0 1 1.06-1.07l.7.71a.75.75 0 0 1 0 1.06Z"/></svg>
          <svg id="icone-lua" viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true" style="display:none"><path d="M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z"/></svg>
        </button>
        <span class="badge-version">{v.data_version} · BNCC 2018</span>
      </nav>
    </header>

    <div class="notice" role="note">
      <strong>Pré-release.</strong>
      <span>Dados completos e verificados contra o documento homologado; a release dados-v1.0.0 sai após o registro da revisão pedagógica.</span>
    </div>

    <main class="shell">
      <slot />
    </main>

    <footer class="rodape">
      <span>bncc.dev · a BNCC em dados abertos, auditáveis e acessíveis</span>
      <a href="https://profy.com.br" rel="noopener">mantido pela Profy</a>
      <a href="https://github.com/bncc-dev/bncc-dados" rel="noopener">dados (CC BY 4.0)</a>
      <a href="https://github.com/bncc-dev/bncc-pacotes" rel="noopener">pacotes e MCP (MIT)</a>
      <a href="/llms.txt">para agentes de IA (llms.txt)</a>
    </footer>

    <script is:inline>
      // tema claro/escuro (persiste a escolha; padrão segue o sistema)
      const btnTema = document.getElementById('alternar-tema');
      const iconeSol = document.getElementById('icone-sol');
      const iconeLua = document.getElementById('icone-lua');
      const temaAtual = () => document.documentElement.dataset.theme
        || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      const atualizarIcone = () => {
        const escuro = temaAtual() === 'dark';
        iconeSol.style.display = escuro ? 'block' : 'none';   // no escuro, oferece o sol
        iconeLua.style.display = escuro ? 'none' : 'block';
      };
      btnTema.addEventListener('click', () => {
        const novo = temaAtual() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = novo;
        localStorage.setItem('tema', novo);
        atualizarIcone();
      });
      atualizarIcone();

      // busca com sugestões ao vivo: compartilhada entre o topbar e a home.
      // Usa o mesmo índice da página /buscar/ (carregado só no primeiro toque).
      window.bnccSugestoes = (form, input) => {
        const rotaDe = (c) => (c.startsWith('EI') ? `/objetivo/${c}/` : `/habilidade/${c}/`);
        const eCodigo = (q) => /^(EI0[123](EO|CG|TS|EF|ET)\d{2}|EF\d{2}[A-Z]{2}\d{2}|EM13[A-Z]{2,3}\d{2,3})$/.test(q);
        const norm = (t) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
        const MAX = 6;

        let indice = null;
        const carregar = async () => indice || (indice = await (await fetch('/buscar-indice.json')).json());

        const box = document.createElement('ul');
        box.className = 'sugestoes';
        box.hidden = true;
        box.setAttribute('role', 'listbox');
        form.appendChild(box);
        let ativa = -1;

        const fechar = () => { box.hidden = true; ativa = -1; };
        const marcar = (i) => {
          ativa = i;
          [...box.children].forEach((li, j) => li.classList.toggle('ativa', j === i));
        };

        const trecho = (texto, bruto) => {
          const el = document.createElement('span');
          el.className = 'trecho';
          const pos = texto.toLowerCase().indexOf(bruto.toLowerCase());
          if (pos === -1) { el.textContent = texto.length > 90 ? texto.slice(0, 87) + '…' : texto; return el; }
          const ini = Math.max(0, pos - 28);
          const fim = Math.min(texto.length, pos + bruto.length + 55);
          if (ini > 0) el.append('…');
          el.append(texto.slice(ini, pos));
          const m = document.createElement('mark');
          m.textContent = texto.slice(pos, pos + bruto.length);
          el.append(m, texto.slice(pos + bruto.length, fim));
          if (fim < texto.length) el.append('…');
          return el;
        };

        const render = (achados, bruto, total) => {
          box.innerHTML = '';
          for (const r of achados) {
            const li = document.createElement('li');
            li.setAttribute('role', 'option');
            const a = document.createElement('a');
            a.href = rotaDe(r.c);
            const cod = document.createElement('span');
            cod.className = 'cod'; cod.textContent = r.c;
            const tr = trecho(r.t, bruto);
            const ctx = document.createElement('small');
            ctx.textContent = [r.g, r.a && r.a.map((x) => x + 'º').join(' e ') + ' ano', r.p].filter(Boolean).join(' · ');
            tr.appendChild(ctx);
            a.append(cod, tr);
            li.appendChild(a);
            box.appendChild(li);
          }
          if (total === 0) {
            const li = document.createElement('li');
            li.className = 'nada';
            li.textContent = 'Nada com esse termo nos enunciados oficiais.';
            box.appendChild(li);
          } else {
            const li = document.createElement('li');
            li.className = 'ver-todos';
            li.setAttribute('role', 'option');
            const a = document.createElement('a');
            a.href = `/buscar/?q=${encodeURIComponent(bruto)}`;
            a.textContent = total > achados.length
              ? `ver todos os ${total.toLocaleString('pt-BR')} resultados →`
              : 'abrir na busca completa →';
            li.appendChild(a);
            box.appendChild(li);
          }
          box.hidden = false;
          marcar(-1);
        };

        let debounce;
        input.addEventListener('input', () => {
          clearTimeout(debounce);
          const bruto = input.value.trim();
          if (bruto.length < 2) { fechar(); return; }
          debounce = setTimeout(async () => {
            const idx = await carregar();
            const alvo = norm(bruto);
            const cod = bruto.toUpperCase();
            const porCodigo = idx.filter((r) => r.c.startsWith(cod));
            const porTexto = porCodigo.length < MAX ? idx.filter((r) => norm(r.t).includes(alvo)) : [];
            const achados = [...porCodigo, ...porTexto].slice(0, MAX);
            render(achados, bruto, porCodigo.length + porTexto.length);
          }, 180);
        });

        input.addEventListener('keydown', (e) => {
          if (box.hidden) return;
          const opcoes = [...box.querySelectorAll('li[role="option"]')];
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            const passo = e.key === 'ArrowDown' ? 1 : -1;
            const idx = [...box.children].indexOf(opcoes[(opcoes.findIndex((o) => o.classList.contains('ativa')) + passo + opcoes.length) % opcoes.length]);
            marcar(idx);
          } else if (e.key === 'Escape') fechar();
          else if (e.key === 'Enter' && ativa >= 0) {
            e.preventDefault();
            box.children[ativa].querySelector('a').click();
          }
        });

        document.addEventListener('click', (e) => { if (!form.contains(e.target)) fechar(); });

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const bruto = input.value.trim();
          if (!bruto) return;
          const q = bruto.toUpperCase();
          if (eCodigo(q)) location.href = rotaDe(q);
          else location.href = `/buscar/?q=${encodeURIComponent(bruto)}`;
        });
      };

      const form = document.getElementById('busca-codigo');
      if (form) {
        const input = form.querySelector('input');
        document.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); }
        });
        window.bnccSugestoes(form, input);
      }

      // decoder: hover/focus/tap
      const out = document.getElementById('decoder-out');
      if (out) {
        const outDefault = out.innerHTML;
        let tapped = null;
        const segs = document.querySelectorAll('.decoder-seg');
        segs.forEach((seg) => {
          const show = () => { out.innerHTML = seg.dataset.exp; };
          const hide = () => { if (!tapped) out.innerHTML = outDefault; };
          seg.addEventListener('mouseenter', show);
          seg.addEventListener('mouseleave', hide);
          seg.addEventListener('focus', show);
          seg.addEventListener('blur', hide);
          seg.addEventListener('click', () => {
            if (tapped === seg) { tapped = null; seg.style.background = ''; out.innerHTML = outDefault; }
            else { segs.forEach((s) => (s.style.background = '')); tapped = seg; seg.style.background = 'var(--accent-bg)'; show(); }
          });
        });
      }

      // tabs
      document.querySelectorAll('.tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach((t) => t.setAttribute('aria-selected', 'false'));
          document.querySelectorAll('[role="tabpanel"]').forEach((p) => (p.hidden = true));
          tab.setAttribute('aria-selected', 'true');
          document.getElementById(tab.dataset.panel).hidden = false;
        });
      });

      // copiar
      window.copiarTexto = (texto, btn) => {
        navigator.clipboard?.writeText(texto).then(() => {
          const prev = btn.innerHTML;
          btn.innerHTML = 'copiado ✓';
          setTimeout(() => (btn.innerHTML = prev), 1400);
        });
      };
      window.copiarBloco = (btn) => {
        // o botão pode morar numa barra (janela de arquivo) ou direto no painel
        const escopo = btn.closest('.arquivo') || btn.parentElement;
        const alvo = escopo.querySelector('pre, q');
        window.copiarTexto(alvo.innerText, btn);
      };
    </script>
  </body>
</html>
