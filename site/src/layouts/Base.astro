---
import '../styles/global.css';
import { versao } from '../lib/dados';

interface Props {
  titulo: string;
  descricao: string;
  jsonLd?: object;
}
const { titulo, descricao, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const v = versao();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="bncc.dev" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="topbar">
      <a class="wordmark" href="/">bncc<span class="dot">·</span>dev</a>
      <form class="search" role="search" id="busca-codigo">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"/></svg>
        <input type="search" name="q" placeholder="Ir para um código… ex.: EF67LP08" aria-label="Ir para um código da BNCC" />
        <kbd>/</kbd>
      </form>
      <nav class="topbar-links" aria-label="Navegação principal">
        <a href="/infantil/">Infantil</a>
        <a href="/fundamental/">Fundamental</a>
        <a href="/medio/">Médio</a>
        <a href="/sobre/">Sobre</a>
        <a href="https://github.com/bncc-dev" rel="noopener">GitHub</a>
        <span class="badge-version">{v.data_version} · BNCC 2018</span>
      </nav>
    </header>

    <div class="notice" role="note">
      <strong>Pré-release.</strong>
      <span>Dados completos e verificados contra o documento homologado; a release dados-v1.0.0 sai após o registro da revisão pedagógica.</span>
    </div>

    <main class="shell">
      <slot />
    </main>

    <footer class="rodape">
      <span>bncc.dev · a BNCC como dados abertos, estruturados e verificados</span>
      <a href="https://profy.com.br" rel="noopener">mantido pela Profy</a>
      <a href="https://github.com/bncc-dev/bncc-dados" rel="noopener">dados (CC BY 4.0)</a>
      <a href="https://github.com/bncc-dev/bncc-pacotes" rel="noopener">pacotes e MCP (MIT)</a>
      <a href="/llms.txt">para agentes de IA (llms.txt)</a>
    </footer>

    <script is:inline>
      // ir-para-código (busca textual completa chega com a plataforma)
      const form = document.getElementById('busca-codigo');
      if (form) {
        const input = form.querySelector('input');
        document.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); }
        });
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const q = input.value.trim().toUpperCase();
          if (/^EI0[123](EO|CG|TS|EF|ET)\d{2}$/.test(q)) location.href = `/objetivo/${q}/`;
          else if (/^(EF\d{2}[A-Z]{2}\d{2}|EM13[A-Z]{2,3}\d{2,3})$/.test(q)) location.href = `/habilidade/${q}/`;
          else input.setCustomValidity('Digite um código BNCC, ex.: EF67LP08'), input.reportValidity(), setTimeout(() => input.setCustomValidity(''), 1500);
        });
      }

      // decoder: hover/focus/tap
      const out = document.getElementById('decoder-out');
      if (out) {
        const outDefault = out.innerHTML;
        let tapped = null;
        const segs = document.querySelectorAll('.decoder-seg');
        segs.forEach((seg) => {
          const show = () => { out.innerHTML = seg.dataset.exp; };
          const hide = () => { if (!tapped) out.innerHTML = outDefault; };
          seg.addEventListener('mouseenter', show);
          seg.addEventListener('mouseleave', hide);
          seg.addEventListener('focus', show);
          seg.addEventListener('blur', hide);
          seg.addEventListener('click', () => {
            if (tapped === seg) { tapped = null; seg.style.background = ''; out.innerHTML = outDefault; }
            else { segs.forEach((s) => (s.style.background = '')); tapped = seg; seg.style.background = 'var(--accent-bg)'; show(); }
          });
        });
      }

      // tabs
      document.querySelectorAll('.tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach((t) => t.setAttribute('aria-selected', 'false'));
          document.querySelectorAll('[role="tabpanel"]').forEach((p) => (p.hidden = true));
          tab.setAttribute('aria-selected', 'true');
          document.getElementById(tab.dataset.panel).hidden = false;
        });
      });

      // copiar
      window.copiarTexto = (texto, btn) => {
        navigator.clipboard?.writeText(texto).then(() => {
          const prev = btn.innerHTML;
          btn.innerHTML = 'copiado ✓';
          setTimeout(() => (btn.innerHTML = prev), 1400);
        });
      };
      window.copiarBloco = (btn) => {
        const pre = btn.parentElement.querySelector('pre');
        window.copiarTexto(pre.innerText, btn);
      };
    </script>
  </body>
</html>
