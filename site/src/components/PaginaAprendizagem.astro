---
/** Página de aprendizagem no layout do mock aprovado (habilidade-ef67lp08.html), com dado real. */
import {
  ETAPAS, GRUPOS_EI_ROTULOS, mesmaCompetenciaEM, mesmaOrganizacaoOutrosAnos,
  mesmasDoObjeto, progressaoEI, rotaDe, segmentosDecoder, urlReportarErro, versao, vizinhanca,
} from '../lib/dados';
import type { AprendizagemResolvida } from '../lib/dados';

interface Props { reg: AprendizagemResolvida }
const { reg } = Astro.props;
const etapa = ETAPAS[reg.etapa];
const v = versao();
const segs = segmentosDecoder(reg.codigo);
const viz = vizinhanca(reg);
const progressao = reg.etapa === 'EI' ? progressaoEI(reg.codigo) : null;
const doObjeto = mesmasDoObjeto(reg);
const outrosAnos = mesmaOrganizacaoOutrosAnos(reg);
const daCompetencia = mesmaCompetenciaEM(reg);
const paginaPdf = reg.fonte.localizador_pdf?.match(/página PDF (\d+)/)?.[1];
const nomes = (reg.organizacao?.nomes ?? {}) as Record<string, string | string[]>;
const anosTxt = reg.anos ? reg.anos.map((a) => `${a}º`).join('–') + ' ano' + (reg.anos.length > 1 ? 's' : '') : null;
const segmentoEF = reg.etapa === 'EF' && reg.anos
  ? (reg.anos.every((a) => a < 6) ? 'Anos Iniciais' : reg.anos.every((a) => a > 5) ? 'Anos Finais' : 'Anos Iniciais e Finais')
  : null;
const decoderResumo = segs.map((s) => s.parte).join(' · ');
const jsonRegistro = JSON.stringify(reg, null, 2);
const cortar = (t: string, n = 96) => (t.length > n ? t.slice(0, n - 1) + '…' : t);
const snippetNpm = `// npm install @bncc/dados (dados embutidos, zero rede)
import { porCodigo, decodificar } from '@bncc/dados';

const h = porCodigo('${reg.codigo}');
h.texto;          // "${cortar(reg.texto, 48)}"
decodificar('${reg.codigo}');`;
const snippetPy = `# pip install bncc (integração com pandas via bncc[pandas])
import bncc

h = bncc.por_codigo('${reg.codigo}')
h['texto']
bncc.para_dataframe('${reg.etapa}')`;
const snippetMcp = `// Claude Code, Cursor etc. (servidor local via stdio)
{
  "mcpServers": {
    "bncc": { "command": "npx", "args": ["-y", "@bncc/mcp"] }
  }
}
// tools: bncc_lookup("${reg.codigo}"), bncc_buscar, bncc_listar…`;
---
<nav class="breadcrumb" aria-label="Trilha">
  <a href={`/${etapa.rota}/`}>{etapa.nome}</a>
  {reg.etapa === 'EF' && reg.anos && (
    <><span class="sep">/</span><span>{segmentoEF}</span>
    <span class="sep">/</span><a href={`/fundamental/${reg.componente!.id.replace('ef-comp-', '')}/`}>{reg.componente!.nome}</a></>
  )}
  {reg.etapa === 'EM' && (
    <><span class="sep">/</span><a href={`/medio/${reg.area!.id.replace('em-area-', '')}/`}>{reg.area!.nome}</a>
    {reg.componente && <><span class="sep">/</span><span>{reg.componente.nome}</span></>}</>
  )}
  {reg.etapa === 'EI' && (
    <><span class="sep">/</span><a href={`/infantil/${reg.campoExperiencias!.id.replace('ei-campo-', '')}/`}>{reg.campoExperiencias!.nome}</a></>
  )}
  {nomes.camposAtuacao && <><span class="sep">/</span><span>{(nomes.camposAtuacao as string[])[0]}</span></>}
</nav>

<div class="title-row">
  <h1 class="codigo">{reg.codigo}</h1>
  <button class="btn" type="button" onclick={`copiarTexto('${reg.codigo}', this)`}>
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"/><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg>
    copiar
  </button>
  <div class="chips">
    <span class="chip accent">{etapa.nome}</span>
    {anosTxt && reg.etapa === 'EF' && <span class="chip">{anosTxt}</span>}
    {reg.etapa === 'EM' && <span class="chip">1ª–3ª série</span>}
    {reg.grupoEtario && <span class="chip">{GRUPOS_EI_ROTULOS[reg.grupoEtario].split(' (')[0]}</span>}
    {reg.componente && <span class="chip">{reg.componente.nome}</span>}
    {reg.etapa === 'EM' && !reg.componente && <span class="chip">{reg.area!.nome}</span>}
  </div>
</div>

<p class="enunciado">{reg.texto}</p>
{paginaPdf && <span class="selo">Texto conferido contra o documento homologado, p. {paginaPdf} do PDF oficial</span>}

<div class="grid">
  <div>
    <section aria-labelledby="h-decoder">
      <h2 id="h-decoder">Como ler este código</h2>
      <p class="h2-hint">Todo código da BNCC é decomponível. Passe o cursor sobre cada parte.</p>
      <div class="decoder" role="group" aria-label={`Decodificação do código ${reg.codigo}`}>
        {segs.map((s) => (
          <div class="decoder-seg" tabindex="0" data-exp={s.explica}>
            <span class="part">{s.parte}</span><span class="label">{s.rotulo}</span>
          </div>
        ))}
      </div>
      <p class="decoder-out" id="decoder-out" aria-live="polite">{decoderResumo}</p>
    </section>

    {doObjeto.length > 0 && (
      <section aria-labelledby="h-objeto">
        <h2 id="h-objeto">No mesmo objeto de conhecimento</h2>
        <p class="h2-hint">{reg.objetosConhecimento!.map((o) => o.nome).join(' · ')}</p>
        <div class="rows">
          {doObjeto.map((h) => (
            <a class="row" href={rotaDe(h.codigo)}>
              <span class="cod">{h.codigo}</span>
              <span class="rel">{h.anos!.map((a) => `${a}º`).join('–')}</span>
              <span class="txt">{cortar(h.texto)}</span>
            </a>
          ))}
          <span class="row current" aria-current="page">
            <span class="cod">{reg.codigo}</span><span class="rel">esta página</span>
            <span class="txt">{cortar(reg.texto)}</span>
          </span>
        </div>
      </section>
    )}

    {outrosAnos.length > 0 && (
      <section aria-labelledby="h-outros-anos">
        <h2 id="h-outros-anos">Em outros anos, {nomes.praticaLinguagem ? 'na mesma prática de linguagem' : 'na mesma unidade temática'}</h2>
        <p class="h2-hint">Aproximação estrutural: a BNCC não define progressão formal entre habilidades; estas compartilham {nomes.praticaLinguagem ? `a prática "${nomes.praticaLinguagem}"` : `a unidade "${nomes.unidadeTematica}"`}.</p>
        <div class="rows">
          {outrosAnos.map((h) => (
            <a class="row" href={rotaDe(h.codigo)}>
              <span class="cod">{h.codigo}</span>
              <span class="rel">{h.anos!.map((a) => `${a}º`).join('–')}</span>
              <span class="txt">{cortar(h.texto)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {daCompetencia.length > 0 && (
      <section aria-labelledby="h-competencia">
        <h2 id="h-competencia">Vinculadas à mesma competência específica</h2>
        <p class="h2-hint">{reg.competenciasEspecificas!.map((c) => `CE ${c.numero}`).join(' · ')} de {reg.area!.nome}</p>
        <div class="rows">
          {daCompetencia.map((h) => (
            <a class="row" href={rotaDe(h.codigo)}>
              <span class="cod">{h.codigo}</span>
              <span class="rel">{h.componente ? 'LP' : 'área'}</span>
              <span class="txt">{cortar(h.texto)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {progressao && (
      <section aria-labelledby="h-progressao">
        <h2 id="h-progressao">Progressão entre as faixas etárias</h2>
        <p class="h2-hint">Objetivos do mesmo aspecto do campo, nas três faixas (relação oficial do documento, p. 26).</p>
        <div class="rows">
          {progressao.objetivos.map((o) => o.codigo === reg.codigo ? (
            <span class="row current" aria-current="page">
              <span class="cod">{o.codigo}</span>
              <span class="rel">{GRUPOS_EI_ROTULOS[o.grupoEtario!].split(' (')[0]}</span>
              <span class="txt">{cortar(o.texto)}</span>
            </span>
          ) : (
            <a class="row" href={rotaDe(o.codigo)}>
              <span class="cod">{o.codigo}</span>
              <span class="rel">{GRUPOS_EI_ROTULOS[o.grupoEtario!].split(' (')[0]}</span>
              <span class="txt">{cortar(o.texto)}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="h-maquina">
      <h2 id="h-maquina">Para máquinas</h2>
      <p class="h2-hint">O mesmo registro, consumível por código e por agentes, sem API key e sem cadastro.</p>
      <div class="tabs" role="tablist" aria-label="Formatos de consumo">
        <button class="tab" role="tab" aria-selected="true" data-panel="p-json" type="button">JSON</button>
        <button class="tab" role="tab" aria-selected="false" data-panel="p-npm" type="button">npm</button>
        <button class="tab" role="tab" aria-selected="false" data-panel="p-py" type="button">Python</button>
        <button class="tab" role="tab" aria-selected="false" data-panel="p-mcp" type="button">MCP</button>
      </div>
      <div class="codeblock" id="p-json" role="tabpanel">
        <button class="btn copy-mini" type="button" onclick="copiarBloco(this)">copiar</button>
        <pre set:text={jsonRegistro} />
      </div>
      <div class="codeblock" id="p-npm" role="tabpanel" hidden>
        <button class="btn copy-mini" type="button" onclick="copiarBloco(this)">copiar</button>
        <pre set:text={snippetNpm} />
      </div>
      <div class="codeblock" id="p-py" role="tabpanel" hidden>
        <button class="btn copy-mini" type="button" onclick="copiarBloco(this)">copiar</button>
        <pre set:text={snippetPy} />
      </div>
      <div class="codeblock" id="p-mcp" role="tabpanel" hidden>
        <button class="btn copy-mini" type="button" onclick="copiarBloco(this)">copiar</button>
        <pre set:text={snippetMcp} />
      </div>
    </section>

    <nav class="rows" aria-label="Sequência" style="display:flex; justify-content:space-between; border:0; margin-top:24px;">
      <span>{viz.anterior && <a class="cod" href={rotaDe(viz.anterior.codigo)}>← {viz.anterior.codigo}</a>}</span>
      <span>{viz.proxima && <a class="cod" href={rotaDe(viz.proxima.codigo)}>{viz.proxima.codigo} →</a>}</span>
    </nav>
  </div>

  <aside aria-label="Metadados">
    <div class="aside-block">
      <h2>Sobre</h2>
      <dl class="meta">
        <div><dt>Etapa</dt><dd>{etapa.nome}{segmentoEF ? ` · ${segmentoEF}` : ''}</dd></div>
        {anosTxt && reg.etapa === 'EF' && <div><dt>Anos</dt><dd>{reg.anos!.map((a) => `${a}º`).join(' e ')}</dd></div>}
        {reg.etapa === 'EM' && <div><dt>Séries</dt><dd>1ª a 3ª (sem seriação)</dd></div>}
        {reg.grupoEtario && <div><dt>Grupo etário</dt><dd>{GRUPOS_EI_ROTULOS[reg.grupoEtario]}</dd></div>}
        {reg.campoExperiencias && <div><dt>Campo de experiências</dt><dd>{reg.campoExperiencias.nome}</dd></div>}
        {reg.componente && <div><dt>Componente</dt><dd>{reg.componente.nome}</dd></div>}
        {reg.area && <div><dt>Área</dt><dd>{reg.area.nome}</dd></div>}
        {nomes.camposAtuacao && <div><dt>Campo de atuação</dt><dd>{(nomes.camposAtuacao as string[]).join(' · ')}</dd></div>}
        {nomes.praticaLinguagem && <div><dt>Prática de linguagem</dt><dd>{nomes.praticaLinguagem}</dd></div>}
        {nomes.unidadeTematica && <div><dt>Unidade temática</dt><dd>{nomes.unidadeTematica}</dd></div>}
        {nomes.eixo && <div><dt>Eixo</dt><dd>{nomes.eixo}</dd></div>}
        {reg.objetosConhecimento && reg.objetosConhecimento.length > 0 && (
          <div><dt>Objeto{reg.objetosConhecimento.length > 1 ? 's' : ''} de conhecimento</dt>
          <dd>{reg.objetosConhecimento.map((o) => o.nome).join(' · ')}</dd></div>
        )}
        {reg.competenciasEspecificas && reg.competenciasEspecificas.length > 0 && (
          <div><dt>Competência{reg.competenciasEspecificas.length > 1 ? 's' : ''} específica{reg.competenciasEspecificas.length > 1 ? 's' : ''}</dt>
          <dd>{reg.competenciasEspecificas.map((c) => `CE ${c.numero}`).join(' · ')}</dd></div>
        )}
      </dl>
    </div>
    <div class="aside-block">
      <h2>Proveniência</h2>
      <p>Extraído das fontes oficiais do MEC por processo reprodutível, validado em CI.</p>
      {reg.fonte.localizador && <p>Planilha oficial: {reg.fonte.localizador}</p>}
      {paginaPdf && <p><a href="http://basenacionalcomum.mec.gov.br" rel="noopener">Documento homologado, p. {paginaPdf} do PDF ↗</a></p>}
      <p><a href="https://github.com/bncc-dev/bncc-dados/blob/main/DECISOES.md" rel="noopener">Decisões de interpretação (DECISOES.md)</a></p>
    </div>
    <div class="aside-block">
      <h2>Versão e licença</h2>
      <p><span class="mono">{v.data_version}</span> · vigência: {reg.vigencia.status}</p>
      <p>Dados <a href="https://creativecommons.org/licenses/by/4.0/deed.pt-br" rel="noopener">CC BY 4.0</a> · código <a href="https://github.com/bncc-dev/bncc-pacotes/blob/main/LICENSE" rel="noopener">MIT</a>: livres, sem cadastro.</p>
      <p><a href="https://github.com/bncc-dev/bncc-dados/blob/main/CHANGELOG.md" rel="noopener">Changelog</a> · <a href={urlReportarErro(reg.codigo)} rel="noopener">Reportar erro neste registro</a></p>
    </div>
    <div class="aside-block">
      <h2>Citar esta página</h2>
      <p>URL permanente:</p>
      <p><a class="mono" href={rotaDe(reg.codigo)}>bncc.dev{rotaDe(reg.codigo)}</a></p>
    </div>
  </aside>
</div>
